{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "defeat-vn",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "defeat.vn",
      "custom_domain": true
    },
    {
      "pattern": "www.defeat.vn",
      "custom_domain": true
    }
  ]
}