---
/**
 * Layout gốc (app shell): <html>, <head> (SEO, font, icon), topbar, header, footer, script giao diện.
 * Mọi trang đều đi qua layout này.
 */
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { SITE } from '@config/site';
import { LOCALE_META } from '@i18n/config';
import { resolveLocale, useTranslations, localizePath } from '@i18n/utils';
import Seo, { type SeoProps } from '@shared/seo/Seo.astro';
import Topbar from '../shell/Topbar.astro';
import Header from '../shell/Header.astro';
import Footer from '../shell/Footer.astro';

type Props = Omit<SeoProps, 'locale'> & { hideCtaBand?: boolean };

const props = Astro.props as Props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

/**
 * Kiểu hiệu ứng chuyển trang theo LOẠI TRANG ĐÍCH (xem global.css, mục PAGE TRANSITIONS):
 * home → iris · danh sách → curtain · chi tiết → push · liên hệ → focus · giới thiệu → shutter · còn lại → fade.
 */
const LIST_SECTIONS = ['services', 'products', 'case-studies', 'news'];
const segs = props.path.split('/').filter(Boolean);
const vt =
  segs.length === 0
    ? 'home'
    : segs.length === 1 && LIST_SECTIONS.includes(segs[0]!)
      ? 'list'
      : segs.length >= 2 && LIST_SECTIONS.includes(segs[0]!)
        ? 'detail'
        : segs[0] === 'contact'
          ? 'contact'
          : segs[0] === 'about'
            ? 'about'
            : 'plain';
---

<!doctype html>
<html lang={LOCALE_META[locale].hreflang} data-theme="defeat" data-vt={vt}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <!--
      Nhận biết kiểu điều hướng TRƯỚC khi trang mới hiển thị (pagereveal phải đăng ký sớm, trong <head>):
      - cùng trang, khác ngôn ngữ → "lang" (lật trang)
      - nút Back/Forward          → "back" (đẩy ngược chiều)
    -->
    <script is:inline>
      addEventListener('pagereveal', function (e) {
        var a = window.navigation && navigation.activation;
        if (!e.viewTransition || !a || !a.from) return;
        var strip = function (u) { return new URL(u).pathname.replace(/^\/en(?=\/|$)/, '') || '/'; };
        if (strip(a.from.url) === strip(a.entry.url) && a.from.url !== a.entry.url) e.viewTransition.types.add('lang');
        else if (a.navigationType === 'traverse') e.viewTransition.types.add('back');
      });
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — ${t('nav.news')}`} href={localizePath('/rss.xml', locale)} />
    <!-- Preload đủ cả subset latin + vietnamese: chuyển ngôn ngữ không phải tải font mới giữa chừng. -->
    <Font cssVariable="--font-inter" preload />
    <Seo {...props} locale={locale} />
    <slot name="head" />
  </head>
  <body id="top" class="flex min-h-dvh flex-col bg-base-100 font-sans text-base-content">
    <a href="#main" class="btn btn-primary btn-sm sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100]">
      {t('common.skipToContent')}
    </a>
    <Topbar locale={locale} />
    <Header locale={locale} path={props.path} availableLocales={props.availableLocales} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} hideCtaBand={props.hideCtaBand} />
    <script>
      import '@shared/motion/index';
    </script>
  </body>
</html>
