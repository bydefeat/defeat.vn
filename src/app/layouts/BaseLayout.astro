---
/**
 * Layout gốc (app shell): <html>, <head> (SEO, font, icon), topbar, header, footer, script giao diện.
 * Mọi trang đều đi qua layout này.
 */
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { SITE } from '@config/site';
import { LOCALE_META } from '@i18n/config';
import { resolveLocale, useTranslations, localizePath } from '@i18n/utils';
import Seo, { type SeoProps } from '@shared/seo/Seo.astro';
import Topbar from '../shell/Topbar.astro';
import Header from '../shell/Header.astro';
import Footer from '../shell/Footer.astro';

type Props = Omit<SeoProps, 'locale'> & { hideCtaBand?: boolean };

const props = Astro.props as Props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<!doctype html>
<html lang={LOCALE_META[locale].hreflang} data-theme="defeat">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — ${t('nav.news')}`} href={localizePath('/rss.xml', locale)} />
    <!-- Preload đủ cả subset latin + vietnamese: chuyển ngôn ngữ không phải tải font mới giữa chừng. -->
    <Font cssVariable="--font-inter" preload />
    <Seo {...props} locale={locale} />
    <slot name="head" />
  </head>
  <body id="top" class="flex min-h-dvh flex-col bg-base-100 font-sans text-base-content">
    <a href="#main" class="btn btn-primary btn-sm sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100]">
      {t('common.skipToContent')}
    </a>
    <Topbar locale={locale} />
    <Header locale={locale} path={props.path} availableLocales={props.availableLocales} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} hideCtaBand={props.hideCtaBand} />
    <script>
      import '@shared/motion/index';
    </script>
  </body>
</html>
