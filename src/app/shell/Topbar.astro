---
/** Topbar thông tin liên hệ (desktop). Nằm ngoài header sticky nên cuộn đi tự nhiên. */
import { SITE } from '@config/site';
import type { Locale } from '@i18n/config';
import { useTranslations } from '@i18n/utils';
import Icon from '@shared/components/Icon.astro';

interface Props { locale: Locale }
const t = useTranslations(Astro.props.locale);
---

<div class="hidden border-b border-base-300 bg-base-200 md:block">
  <div class="container-x flex h-9 items-center justify-between text-[13px] text-muted">
    <p>{t('header.response')}</p>
    <div class="flex items-center gap-6">
      <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-1.5 transition-colors hover:text-primary">
        <Icon name="phone" class="size-3.5" />{SITE.phone}
      </a>
      <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-1.5 transition-colors hover:text-primary">
        <Icon name="mail" class="size-3.5" />{SITE.email}
      </a>
    </div>
  </div>
</div>
