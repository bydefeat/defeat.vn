---
import { SITE } from '@config/site';
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import Icon from '@shared/components/Icon.astro';
import SocialIcon from '@shared/components/SocialIcon.astro';
import { SERVICES } from '@modules/services/data';
import CtaBand from './CtaBand.astro';

interface Props {
  locale: Locale;
  hideCtaBand?: boolean;
}

const { locale, hideCtaBand = false } = Astro.props;
const t = useTranslations(locale);
const href = (p: string) => localizePath(p, locale);
const year = new Date().getFullYear();

const columns = [
  {
    title: t('nav.services'),
    links: SERVICES.slice(0, 4).map((s) => ({ label: s.title[locale], href: href(`/services/${s.slug}`) })),
  },
  {
    title: t('footer.company'),
    links: [
      { label: t('nav.about'), href: href('/about') },
      { label: t('nav.caseStudies'), href: href('/case-studies') },
      { label: t('nav.products'), href: href('/products') },
      { label: t('nav.contact'), href: href('/contact') },
    ],
  },
  {
    title: t('footer.resources'),
    links: [
      { label: t('nav.news'), href: href('/news') },
      { label: t('footer.rss'), href: href('/rss.xml') },
      { label: t('footer.privacy'), href: href('/privacy') },
      { label: t('footer.terms'), href: href('/terms') },
    ],
  },
];
const socials = Object.entries(SITE.social).filter(([, url]) => url);
const socialLabel: Record<string, string> = { github: 'GitHub', telegram: 'Telegram' };
---

{!hideCtaBand && <CtaBand locale={locale} />}

<footer class="container-x pb-10 pt-6">
  <div class="grid gap-10 pb-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <a href={href('/')} class="inline-flex" aria-label="DEFEAT">
        <img src="/brand/defeat_logo.png" alt="DEFEAT" width="961" height="961" loading="lazy" class="size-8" />
      </a>
      <p class="mt-4 max-w-xs text-sm text-muted">{t('footer.tagline')}</p>
      <ul class="mt-5 space-y-1.5 text-sm text-muted">
        <li><a class="hover:text-base-content" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a class="hover:text-base-content" href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>
        <li>{SITE.address.locality}, Việt Nam</li>
      </ul>
    </div>
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4 lg:col-span-7">
      {
        columns.map((col) => (
          <nav aria-label={col.title} class="first:col-span-2 sm:first:col-span-1">
            <h2 class="text-sm font-medium">{col.title}</h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              {col.links.map((l) => (
                <li><a class="text-muted transition-colors hover:text-base-content" href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </nav>
        ))
      }
      <nav aria-label={t('footer.connect')} class="col-span-2 sm:col-span-1">
        <h2 class="text-sm font-medium">{t('footer.connect')}</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {SITE.channels.map((c) => (
            <li>
              <a class="inline-flex items-center gap-2 text-muted transition-colors hover:text-base-content" href={c.url} rel="noopener" target="_blank" title={c.handle}>
                <SocialIcon name={c.icon} class="size-4 shrink-0" />{c.label[locale]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  <div class="frame-t flex flex-col gap-4 pt-6 text-[13px] text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {SITE.legalName}. {t('footer.rights')}</p>
    <div class="flex items-center gap-4">
      {
        socials.map(([name, url]) => (
          <a href={url} rel="noopener" target="_blank" aria-label={socialLabel[name] ?? name} title={socialLabel[name] ?? name} class="flex size-9 items-center justify-center rounded-full transition-colors hover:bg-base-200 hover:text-base-content">
            <SocialIcon name={name} class="size-[18px]" />
          </a>
        ))
      }
      <a href="#top" class="inline-flex items-center gap-1 hover:text-base-content">{t('footer.backToTop')} <Icon name="arrowUp" class="size-3.5" /></a>
    </div>
  </div>
</footer>
