---
/** Dải CTA trước footer: nền navy, tiêu đề + mô tả + 2 nút. */
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import Icon from '@shared/components/Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="bg-secondary text-secondary-content" aria-labelledby="cta-band-title">
  <div class="container-x flex flex-col gap-8 py-14 sm:py-16 lg:flex-row lg:items-center lg:justify-between" data-reveal>
    <div class="max-w-2xl">
      <h2 id="cta-band-title" class="t-h2">{t('ctaBand.title')}</h2>
      <p class="mt-3 text-secondary-content/75">{t('ctaBand.desc')}</p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <a href={localizePath('/contact', locale)} class="btn btn-primary btn-lg">
        {t('cta.quote')} <Icon name="arrowRight" class="arrow size-5" />
      </a>
      <a href={localizePath('/services', locale)} class="btn btn-lg btn-outline border-white/40 text-secondary-content hover:border-white hover:bg-white hover:text-secondary">
        {t('nav.services')}
      </a>
    </div>
  </div>
</section>
