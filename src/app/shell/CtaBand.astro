---
/** Dải CTA trước footer: nền đỏ + dither trôi, tiêu đề lớn, nút nam châm. */
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import Icon from '@shared/components/Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="on-red relative overflow-hidden bg-primary text-primary-content" aria-labelledby="cta-band-title">
  <span class="dither dither-lg dither-drift pointer-events-none absolute inset-0 text-neutral/25" aria-hidden="true"></span>
  <span class="dither-edge dither-edge-top text-base-100" aria-hidden="true"></span>
  <div class="container-x relative grid items-end gap-10 pb-20 pt-36 lg:grid-cols-12">
    <div class="lg:col-span-8" data-reveal>
      <p class="label-mono text-primary-content/80">/ {t('cta.contact')}</p>
      <h2 id="cta-band-title" class="display mt-4 text-4xl leading-[1.05] sm:text-6xl">{t('ctaBand.title')}</h2>
      <p class="mt-6 max-w-2xl text-lg text-primary-content/85">{t('ctaBand.desc')}</p>
    </div>
    <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end" data-reveal>
      <a href={localizePath('/contact', locale)} class="btn btn-neutral btn-lg" data-magnetic="0.25">
        {t('cta.quote')} <Icon name="arrowRight" class="arrow size-5" />
      </a>
      <a href={localizePath('/services', locale)} class="btn btn-lg btn-outline border-primary-content/60 text-primary-content hover:border-primary-content hover:bg-primary-content hover:text-primary">
        {t('nav.services')}
      </a>
    </div>
  </div>
</section>
