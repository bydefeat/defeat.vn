---
/** CTA cuối trang: khung nét đứt, nền ASCII art động (src/shared/motion/ascii-field.ts), tiêu đề lớn căn giữa, nút viên thuốc. */
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import Icon from '@shared/components/Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="container-x py-14 sm:py-20" aria-labelledby="cta-band-title">
  <div class="ascii-field frame relative overflow-hidden rounded-box px-6 py-20 text-center sm:py-28" data-ascii-field data-ascii-src="/brand/defeat_logo.png" data-reveal>
    <div class="relative z-10 mx-auto max-w-2xl">
      <h2 id="cta-band-title" class="t-display">{t('ctaBand.title')}</h2>
      <p class="t-lead mx-auto mt-5 max-w-lg text-muted">{t('ctaBand.desc')}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={localizePath('/contact', locale)} class="btn btn-invert btn-lg">
          {t('cta.quote')} <Icon name="arrowRight" class="arrow size-5" />
        </a>
        <a href={localizePath('/services', locale)} class="btn btn-line btn-lg">{t('nav.services')}</a>
      </div>
    </div>
  </div>
</section>
