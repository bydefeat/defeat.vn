---
import { Image } from 'astro:assets';
import { LOCALE_META, type Locale } from '@i18n/config';
import { entryLocale } from '@shared/lib/content';
import { localizePath, useTranslations } from '@i18n/utils';
import Icon from '@shared/components/Icon.astro';
import { caseStudyPath, type CaseStudyEntry } from '../api';

interface Props { item: CaseStudyEntry; locale: Locale; headingLevel?: 'h2' | 'h3' }
const { item, locale, headingLevel: H = 'h3' } = Astro.props;
const t = useTranslations(locale);
const { data } = item;
// Bản dự phòng (chưa dịch) → khai báo đúng ngôn ngữ của tiêu đề/tóm tắt.
const contentLang = entryLocale(item) !== locale ? LOCALE_META[entryLocale(item)].hreflang : undefined;
const href = localizePath(caseStudyPath(item), locale);
---

<article class="card-base card-hover md:!flex-row" data-reveal lang={contentLang}>
  <div class="aspect-[16/9] overflow-hidden md:aspect-auto md:w-2/5 md:shrink-0">
    {
      data.cover ? (
        <Image src={data.cover} alt={data.coverAlt ?? data.title} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="card-img size-full object-cover" />
      ) : (
        <div class="cover-placeholder size-full min-h-44"><Icon name="layers" class="size-10" /></div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <span class="pill self-start">{data.industry}</span>
    <H class="card-title t-h3 mt-3 text-xl">
      <a href={href} class="after:absolute after:inset-0">{data.title}</a>
    </H>
    <p class="mt-2 flex-1 text-[15px] text-muted">{data.summary}</p>
    {
      data.results.length > 0 && (
        <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {data.results.slice(0, 3).map((r) => (
            <div class="flex flex-col-reverse rounded-lg bg-base-200 p-3">
              <dt class="text-xs text-muted">{r.label}</dt>
              <dd class="text-xl font-extrabold text-primary">{r.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
      {t('cta.viewDetail')} <Icon name="arrowRight" class="size-4" />
    </span>
  </div>
</article>
