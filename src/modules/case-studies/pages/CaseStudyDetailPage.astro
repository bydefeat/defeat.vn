---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@app/layouts/BaseLayout.astro';
import PageHero from '@shared/components/PageHero.astro';
import { articleLd, breadcrumbLd } from '@shared/seo/jsonld';
import { resolveLocale, useTranslations, localizePath } from '@i18n/utils';
import type { Locale } from '@i18n/config';
import { caseStudyPath, type CaseStudyEntry } from '../api';
import { caseStudiesText } from '../i18n';

interface Props { item: CaseStudyEntry; availableLocales: Locale[] }
const { item, availableLocales } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const text = caseStudiesText[locale];
const { data } = item;
const path = caseStudyPath(item);
const { Content } = await render(item);
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.caseStudies'), href: localizePath('/case-studies', locale) },
  { name: data.title, href: localizePath(path, locale) },
];
---

<BaseLayout
  title={data.title}
  description={data.summary}
  path={path}
  type="article"
  availableLocales={availableLocales}
  image={data.cover?.src}
  publishedTime={data.date}
  jsonLd={[
    articleLd({ title: data.title, description: data.summary, path: localizePath(path, locale), image: data.cover?.src, datePublished: data.date, locale }),
    breadcrumbLd(crumbs),
  ]}
>
  <PageHero eyebrow={data.industry} title={data.title} description={data.summary} crumbs={crumbs} />

  {
    data.results.length > 0 && (
      <section class="border-b border-base-300" aria-label={text.results}>
        <dl class="container-x grid grid-cols-2 gap-6 py-10 md:grid-cols-4" data-reveal-group="100">
          {data.results.map((r) => (
            <div data-reveal="rise">
              <dt class="text-[13px] text-base-content/55">{r.label}</dt>
              <dd class="num mt-1 text-3xl font-semibold text-primary">{r.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-3">
      <article class="lg:col-span-2" data-reveal="dissolve">
        {data.cover && <Image src={data.cover} alt={data.coverAlt ?? data.title} widths={[800, 1200]} sizes="(min-width: 1024px) 66vw, 100vw" class="mb-10 w-full rounded-box" loading="eager" />}
        <div class="prose-defeat"><Content /></div>
      </article>
      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <dl class="space-y-4 rounded-box bg-base-200 p-5 text-sm">
          <div><dt class="text-base-content/60">{text.client}</dt><dd class="font-semibold">{data.client}</dd></div>
          <div><dt class="text-base-content/60">{t('common.industry')}</dt><dd class="font-semibold">{data.industry}</dd></div>
          {data.techStack.length > 0 && (
            <div>
              <dt class="text-base-content/60">{t('common.techStack')}</dt>
              <dd class="mt-2 flex flex-wrap gap-1.5">{data.techStack.map((s) => <span class="badge badge-ghost">{s}</span>)}</dd>
            </div>
          )}
        </dl>
        <a href={localizePath('/contact', locale)} class="btn btn-primary btn-block">{t('cta.quote')}</a>
      </aside>
    </div>
  </section>
</BaseLayout>
