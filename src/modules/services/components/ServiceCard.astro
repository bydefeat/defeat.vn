---
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import type { Service } from '../data';

interface Props { service: Service; locale: Locale; index?: number; total?: number; headingLevel?: 'h2' | 'h3' }
const { service, locale, index, headingLevel: H = 'h3' } = Astro.props;
const t = useTranslations(locale);
const href = localizePath(`/services/${service.slug}`, locale);
---

<article class="card-base card-hover p-6" data-reveal>
  <div class="flex items-start justify-between">
    <span class="icon-chip"><Icon name={service.icon} class="size-5" /></span>
    {index !== undefined && <span class="rounded bg-base-200 px-2 py-0.5 text-xs font-bold text-muted">{String(index + 1).padStart(2, '0')}</span>}
  </div>
  <H class="card-title t-h3 mt-5">
    <a href={href} class="after:absolute after:inset-0">{service.title[locale]}</a>
  </H>
  <p class="mt-2 flex-1 text-[15px] text-muted">{service.summary[locale]}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
    {t('cta.viewDetail')} <Icon name="arrowRight" class="size-4" />
  </span>
</article>
