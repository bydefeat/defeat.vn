---
import BaseLayout from '@app/layouts/BaseLayout.astro';
import PageHero from '@shared/components/PageHero.astro';
import Icon from '@shared/components/Icon.astro';
import { breadcrumbLd, serviceLd } from '@shared/seo/jsonld';
import { resolveLocale, useTranslations, localizePath } from '@i18n/utils';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES, type Service } from '../data';
import { servicesText } from '../i18n';

interface Props { service: Service }
const { service } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const text = servicesText[locale];
const path = `/services/${service.slug}`;
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.services'), href: localizePath('/services', locale) },
  { name: service.title[locale], href: localizePath(path, locale) },
];
const others = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<BaseLayout
  title={service.title[locale]}
  description={service.summary[locale]}
  path={path}
  jsonLd={[serviceLd({ name: service.title[locale], description: service.summary[locale], path: localizePath(path, locale) }), breadcrumbLd(crumbs)]}
>
  <PageHero eyebrow={text.eyebrow} title={service.title[locale]} description={service.summary[locale]} crumbs={crumbs}>
    <a href={localizePath('/contact', locale)} class="btn btn-primary btn-lg mt-10" data-magnetic="0.2">{t('cta.quote')} <Icon name="arrowRight" class="arrow size-5" /></a>
  </PageHero>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="display text-3xl" data-reveal>{text.included}</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2" data-reveal-group="90">
          {
            service.points[locale].map((p) => (
              <li class="card-fx flex gap-4 border border-base-300 bg-base-100 p-5" data-reveal>
                <Icon name="check" class="size-5 shrink-0 text-primary" />
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="on-dark relative self-start overflow-hidden bg-neutral p-7 text-neutral-content lg:sticky lg:top-28" data-reveal>
        <span class="dither dither-6 dither-drift pointer-events-none absolute inset-0 text-primary/60" aria-hidden="true"></span>
        <h2 class="relative text-xl font-bold">{t('cta.contact')}</h2>
        <p class="relative mt-3 text-sm text-neutral-content/70">{t('ctaBand.desc')}</p>
        <a href={localizePath('/contact', locale)} class="btn btn-primary btn-block relative mt-6">{t('cta.quote')}</a>
      </aside>
    </div>
  </section>

  <section class="section border-t border-base-300">
    <div class="container-x">
      <h2 class="display text-3xl" data-reveal>{t('nav.services')}</h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group="90">
        {others.map((s) => <ServiceCard service={s} locale={locale} index={SERVICES.indexOf(s)} total={SERVICES.length} />)}
      </div>
    </div>
  </section>
</BaseLayout>
