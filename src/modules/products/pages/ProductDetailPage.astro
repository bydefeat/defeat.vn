---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@app/layouts/BaseLayout.astro';
import PageHero from '@shared/components/PageHero.astro';
import Icon from '@shared/components/Icon.astro';
import TechStack from '@shared/components/TechStack.astro';
import ImageLightbox from '@shared/components/ImageLightbox.astro';
import { breadcrumbLd, softwareLd } from '@shared/seo/jsonld';
import { entryLocale } from '@shared/lib/content';
import { resolveLocale, useTranslations, localizePath } from '@i18n/utils';
import type { Locale } from '@i18n/config';
import PriceTag from '../components/PriceTag.astro';
import PriceTagFallback from '../components/PriceTagFallback.astro';
import { productPath, productSlug, type ProductEntry } from '../api';
import { productsText } from '../i18n';

interface Props { product: ProductEntry; availableLocales: Locale[]; translations: Locale[] }
const { product, availableLocales, translations } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const text = productsText[locale];
const { data } = product;
const path = productPath(product);
const { Content } = await render(product);
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.products'), href: localizePath('/products', locale) },
  { name: data.title, href: localizePath(path, locale) },
];
---

<BaseLayout
  title={data.title}
  description={data.summary}
  path={path}
  type="product"
  availableLocales={availableLocales}
  translations={translations}
  contentLocale={entryLocale(product)}
  image={data.cover?.src}
  jsonLd={[
    softwareLd({ name: data.title, description: data.summary, path: localizePath(path, locale), image: data.cover?.src, category: text.categories[data.category], priceVnd: data.listPriceVnd }),
    breadcrumbLd(crumbs),
  ]}
>
  <PageHero eyebrow={text.categories[data.category]} title={data.title} description={data.summary} crumbs={crumbs} untranslated={entryLocale(product) !== locale} />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2" data-reveal data-lightbox>
        {data.cover && <Image src={data.cover} alt={data.coverAlt ?? data.title} widths={[800, 1200, 1920]} sizes="(min-width: 1024px) 66vw, 100vw" class="mb-10 w-full rounded-box" loading="eager" />}
        <div class="prose-defeat"><Content /></div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start" data-reveal>
        <PriceTag server:defer slug={productSlug(product)} locale={locale}>
          <PriceTagFallback slot="fallback" locale={locale} />
        </PriceTag>
        <div class="flex flex-col gap-3">
          <a href={localizePath('/contact', locale)} class="btn btn-invert">{t('cta.quote')}</a>
          {data.demoUrl && <a href={data.demoUrl} class="btn btn-line" rel="noopener" target="_blank">{text.demo}</a>}
        </div>
        {
          data.features.length > 0 && (
            <div class="rounded-box bg-base-200 p-5">
              <h2 class="font-semibold">{text.features}</h2>
              <ul class="mt-3 space-y-2 text-sm">
                {data.features.map((f) => (
                  <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-primary" />{f}</li>
                ))}
              </ul>
            </div>
          )
        }
        {
          data.techStack.length > 0 && (
            <div>
              <h2 class="text-sm font-semibold">{t('common.techStack')}</h2>
              <div class="mt-3"><TechStack items={data.techStack} label={t('common.techStack')} /></div>
            </div>
          )
        }
      </aside>
    </div>
  </section>
  <ImageLightbox />
</BaseLayout>
