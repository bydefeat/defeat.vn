---
import { Image } from 'astro:assets';
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import { productPath, type ProductEntry } from '../api';
import { productsText } from '../i18n';

interface Props { product: ProductEntry; locale: Locale; headingLevel?: 'h2' | 'h3' }
const { product, locale, headingLevel: H = 'h3' } = Astro.props;
const t = useTranslations(locale);
const text = productsText[locale];
const { data } = product;
const href = localizePath(productPath(product), locale);
---

<article class="group relative flex flex-col overflow-hidden rounded-box border border-base-300 bg-base-100 transition hover:border-primary hover:shadow-lg" data-category={data.category}>
  <div class="aspect-[16/9] overflow-hidden bg-neutral">
    {
      data.cover ? (
        <Image src={data.cover} alt={data.coverAlt ?? data.title} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="size-full object-cover transition duration-300 group-hover:scale-105" />
      ) : (
        <div class="flex size-full items-center justify-center bg-gradient-to-br from-neutral to-primary/60 text-neutral-content">
          <Icon name="box" class="size-12 opacity-80" />
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <span class="badge badge-primary badge-sm">{text.categories[data.category]}</span>
    <H class="mt-3 text-lg font-semibold">
      <a href={href} class="after:absolute after:inset-0">{data.title}</a>
    </H>
    <p class="mt-2 flex-1 text-sm text-base-content/70">{data.summary}</p>
    {
      data.techStack.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={t('common.techStack')}>
          {data.techStack.slice(0, 4).map((tech) => <li class="badge badge-ghost badge-sm">{tech}</li>)}
        </ul>
      )
    }
  </div>
</article>
