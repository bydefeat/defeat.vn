---
import { Image } from 'astro:assets';
import Icon from '@shared/components/Icon.astro';
import TechStack from '@shared/components/TechStack.astro';
import { LOCALE_META, type Locale } from '@i18n/config';
import { entryLocale } from '@shared/lib/content';
import { localizePath, useTranslations } from '@i18n/utils';
import { productPath, type ProductEntry } from '../api';
import { productsText } from '../i18n';

interface Props { product: ProductEntry; locale: Locale; headingLevel?: 'h2' | 'h3' }
const { product, locale, headingLevel: H = 'h3' } = Astro.props;
const t = useTranslations(locale);
const text = productsText[locale];
const { data } = product;
const contentLang = entryLocale(product) !== locale ? LOCALE_META[entryLocale(product)].hreflang : undefined;
const href = localizePath(productPath(product), locale);
---

<article class="card-base card-hover" data-category={data.category} data-reveal lang={contentLang}>
  <div class="aspect-[16/9] overflow-hidden">
    {
      data.cover ? (
        <Image src={data.cover} alt={data.coverAlt ?? data.title} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="card-img size-full object-cover" />
      ) : (
        <div class="cover-placeholder size-full"><Icon name="box" class="size-10" /></div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <span class="pill self-start">{text.categories[data.category]}</span>
    <H class="card-title t-h3 mt-3">
      <a href={href} class="after:absolute after:inset-0">{data.title}</a>
    </H>
    <p class="mt-2 flex-1 text-[15px] text-muted">{data.summary}</p>
    {
      data.techStack.length > 0 && (
        <div class="mt-4"><TechStack items={data.techStack.slice(0, 4)} label={t('common.techStack')} compact /></div>
      )
    }
  </div>
</article>
