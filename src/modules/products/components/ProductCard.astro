---
import { Image } from 'astro:assets';
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import { productPath, type ProductEntry } from '../api';
import { productsText } from '../i18n';

interface Props { product: ProductEntry; locale: Locale; headingLevel?: 'h2' | 'h3' }
const { product, locale, headingLevel: H = 'h3' } = Astro.props;
const t = useTranslations(locale);
const text = productsText[locale];
const { data } = product;
const href = localizePath(productPath(product), locale);
---

<article class="card-fx group flex h-full flex-col border border-base-300 bg-base-100" data-category={data.category} data-reveal>
  <div class="relative aspect-[16/10] overflow-hidden">
    {
      data.cover ? (
        <Image src={data.cover} alt={data.coverAlt ?? data.title} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="media size-full object-cover" />
      ) : (
        <div class="cover-dither media flex size-full items-center justify-center">
          <span class="relative z-10 flex size-16 items-center justify-center border border-white/15 bg-neutral/60 text-neutral-content backdrop-blur-sm">
            <Icon name="box" class="size-7" />
          </span>
        </div>
      )
    }
    <span class="label-mono absolute left-4 top-4 z-10 bg-primary px-2 py-1 text-primary-content">{text.categories[data.category]}</span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <H class="text-lg font-bold tracking-tight">
      <a href={href} class="after:absolute after:inset-0">{data.title}</a>
    </H>
    <p class="mt-2 flex-1 text-sm text-base-content/65">{data.summary}</p>
    {
      data.techStack.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={t('common.techStack')}>
          {data.techStack.slice(0, 4).map((tech) => (
            <li class="label-mono border border-base-300 px-2 py-1 text-base-content/60">{tech}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>
