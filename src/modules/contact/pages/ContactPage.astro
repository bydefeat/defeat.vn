---
import BaseLayout from '@app/layouts/BaseLayout.astro';
import PageHero from '@shared/components/PageHero.astro';
import Icon from '@shared/components/Icon.astro';
import SocialIcon from '@shared/components/SocialIcon.astro';
import { breadcrumbLd } from '@shared/seo/jsonld';
import { SITE } from '@config/site';
import { resolveLocale, useTranslations, localizePath } from '@i18n/utils';
import { contactText, contactInfoText } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const text = contactText[locale];
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.contact'), href: localizePath('/contact', locale) },
];
const channel = (key: string) => SITE.channels.find((c) => c.key === key);
const zalo = channel('zalo');
const telegram = channel('telegram');
const quick = [
  zalo && { social: 'zalo', title: 'Zalo', value: zalo.handle, href: zalo.url, cta: text.actions.zalo, external: true },
  telegram && { social: 'telegram', title: 'Telegram', value: telegram.handle, href: telegram.url, cta: text.actions.telegram, external: true },
  { icon: 'mail' as const, title: 'Email', value: SITE.email, href: `mailto:${SITE.email}`, cta: text.actions.email, external: false },
  { icon: 'phone' as const, title: contactInfoText[locale].phone, value: SITE.phone, href: `tel:${SITE.phone.replace(/\s/g, '')}`, cta: text.actions.phone, external: false },
].filter((c) => !!c);
const community = SITE.channels.filter((c) => c.key === 'announcements' || c.key === 'community');
---

<BaseLayout title={text.title} description={text.desc} path="/contact" hideCtaBand jsonLd={[breadcrumbLd(crumbs)]}>
  <PageHero eyebrow={text.eyebrow} title={text.title} description={text.desc} crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-3">
      <div class="space-y-10 lg:col-span-2">
        <div data-reveal>
          <h2 class="t-label text-base-content/50">{text.quickTitle}</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {quick.map((c) => (
              <li>
                <a href={c.href} {...(c.external ? { rel: 'noopener', target: '_blank' } : {})} class="group frame flex h-full flex-col rounded-box p-6 transition-colors hover:bg-base-200/60">
                  <span class="flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-content">
                    {'social' in c && c.social ? <SocialIcon name={c.social} class="size-6" /> : 'icon' in c && c.icon && <Icon name={c.icon} class="size-6" />}
                  </span>
                  <span class="mt-5 text-sm text-muted">{c.title}</span>
                  <span class="mt-1 text-lg font-medium">{c.value}</span>
                  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-primary">
                    {c.cta}<Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div data-reveal>
          <h2 class="t-label text-base-content/50">{text.communityTitle}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {community.map((c) => (
              <li>
                <a href={c.url} rel="noopener" target="_blank" class="frame flex min-h-14 items-center gap-3 rounded-box px-4 transition-colors hover:bg-base-200/60">
                  <SocialIcon name={c.icon} class="size-5 shrink-0 text-primary" />
                  <span>{c.label[locale]} <span class="text-muted">· {c.handle}</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start" data-reveal>
        <div class="frame rounded-box p-6">
          <h2 class="t-label text-base-content/50">{text.stepsTitle}</h2>
          <ol class="mt-5 space-y-6 border-l-2 border-primary/30 pl-6">
            {text.steps.map((s, i) => (
              <li>
                <p class="text-sm font-semibold text-primary">0{i + 1}</p>
                <p class="font-semibold">{s.title}</p>
                <p class="text-sm text-base-content/70">{s.desc}</p>
              </li>
            ))}
          </ol>
        </div>
        <a href={localizePath('/contact-info', locale)} class="btn btn-line w-full">{text.moreInfo}</a>
      </aside>
    </div>
  </section>
</BaseLayout>
