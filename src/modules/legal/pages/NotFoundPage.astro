---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import { resolveLocale, useTranslations, localizePath } from '@i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout title={t('notFound.title')} description={t('notFound.desc')} path="/404" noindex hideCtaBand>
  <section class="section">
    <div class="container-x flex flex-col items-center py-16 text-center">
      <p class="text-8xl font-extrabold text-primary">404</p>
      <h1 class="mt-6 text-3xl font-bold">{t('notFound.title')}</h1>
      <p class="mt-3 text-base-content/70">{t('notFound.desc')}</p>
      <a href={localizePath('/', locale)} class="btn btn-primary mt-8">{t('notFound.back')}</a>
    </div>
  </section>
</BaseLayout>
