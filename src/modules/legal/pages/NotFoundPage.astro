---
import BaseLayout from '@app/layouts/BaseLayout.astro';
import Icon from '@shared/components/Icon.astro';
import { resolveLocale, useTranslations, localizePath } from '@i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout title={t('notFound.title')} description={t('notFound.desc')} path="/404" availableLocales={[]} noindex hideCtaBand>
  <section class="bg-base-200">
    <div class="container-x flex min-h-[70svh] flex-col items-center justify-center py-20 text-center">
      <p class="text-[clamp(5rem,18vw,9rem)] font-extrabold leading-none text-primary" aria-hidden="true">404</p>
      <h1 class="t-h1 mt-4">{t('notFound.title')}</h1>
      <p class="t-lead mt-3 max-w-xl text-muted">{t('notFound.desc')}</p>
      <a href={localizePath('/', locale)} class="btn btn-primary btn-lg mt-8">
        {t('notFound.back')} <Icon name="arrowRight" class="arrow size-5" />
      </a>
    </div>
  </section>
</BaseLayout>
