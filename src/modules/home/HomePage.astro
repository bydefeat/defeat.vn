---
import BaseLayout from '@app/layouts/BaseLayout.astro';
import { organizationLd, websiteLd } from '@shared/seo/jsonld';
import { resolveLocale } from '@i18n/utils';
import Hero from './sections/Hero.astro';
import TechSection from './sections/TechSection.astro';
import BenefitsSection from './sections/BenefitsSection.astro';
import StepsSection from './sections/StepsSection.astro';
import FeaturesSection from './sections/FeaturesSection.astro';
import ShowcaseSection from './sections/ShowcaseSection.astro';
import NewsSection from './sections/NewsSection.astro';
import FaqSection from './sections/FaqSection.astro';
import { homeText } from './i18n';

const locale = resolveLocale(Astro.currentLocale);
const text = homeText[locale];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: text.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={text.seoTitle} description={text.seoDesc} path="/" jsonLd={[organizationLd(), websiteLd(locale), faqLd]}>
  <Hero locale={locale} />
  <TechSection locale={locale} />
  <BenefitsSection locale={locale} />
  <StepsSection locale={locale} />
  <FeaturesSection locale={locale} />
  <ShowcaseSection locale={locale} />
  <NewsSection locale={locale} />
  <FaqSection locale={locale} />
</BaseLayout>
