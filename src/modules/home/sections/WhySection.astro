---
import SectionHeading from '@shared/components/SectionHeading.astro';
import Icon, { type IconName } from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { why, process } = homeText[locale];
const icons: IconName[] = ['layers', 'search', 'shield', 'zap'];
---

<section class="section bg-base-200" aria-labelledby="home-why">
  <div class="container-x">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading id="home-why" index="03" eyebrow={why.eyebrow} title={why.title} description={why.desc} />
      </div>
      <ul class="grid gap-px border border-base-300 bg-base-300 sm:grid-cols-2 lg:col-span-7" data-reveal-group="90">
        {
          why.items.map((item, i) => (
            <li class="card-fx group bg-base-100 p-7" data-reveal>
              <div class="flex items-center justify-between">
                <span class="flex size-11 items-center justify-center bg-primary text-primary-content transition-transform duration-500 group-hover:-rotate-6">
                  <Icon name={icons[i % icons.length]!} class="size-5" />
                </span>
                <span class="label-mono text-base-content/30">0{i + 1}</span>
              </div>
              <h3 class="mt-6 text-lg font-bold">{item.title}</h3>
              <p class="mt-2 text-sm text-base-content/65">{item.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Quy trình: timeline ngang, đường kẻ chạy theo cuộn -->
    <div class="mt-28" aria-labelledby="home-process">
      <div data-reveal>
        <p class="eyebrow"><span data-scramble>{process.eyebrow}</span></p>
        <h2 id="home-process" class="display mt-4 max-w-2xl text-3xl sm:text-4xl">{process.title}</h2>
      </div>
      <div class="relative mt-14">
        <div class="absolute left-0 right-0 top-5 hidden h-px bg-base-300 md:block" aria-hidden="true"></div>
        <div class="process-line absolute left-0 right-0 top-5 hidden h-px bg-primary md:block" aria-hidden="true"></div>
        <ol class="grid gap-10 md:grid-cols-4 md:gap-6" data-reveal-group="140">
          {
            process.steps.map((step, i) => (
              <li class="relative" data-reveal>
                <span class="relative z-10 flex size-10 items-center justify-center bg-neutral font-mono text-sm font-semibold text-neutral-content ring-8 ring-base-200">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-6 text-lg font-bold">{step.title}</h3>
                <p class="mt-2 text-sm text-base-content/65">{step.desc}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
