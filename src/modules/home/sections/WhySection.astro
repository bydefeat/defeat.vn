---
/** Vì sao chọn DEFEAT (4 giá trị) + Quy trình 4 bước. */
import SectionHeading from '@shared/components/SectionHeading.astro';
import Icon, { type IconName } from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { why, process } = homeText[locale];
const icons: IconName[] = ['layers', 'search', 'shield', 'zap'];
---

<section class="section border-t border-base-300" aria-labelledby="home-why">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading id="home-why" eyebrow={why.eyebrow} title={why.title} description={why.desc} />
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7" data-reveal-group="70">
        {
          why.items.map((item, i) => (
            <li class="rounded-box border border-base-300 bg-base-100 p-6" data-reveal>
              <span class="icon-chip"><Icon name={icons[i % icons.length]!} class="size-5" /></span>
              <h3 class="t-h3 mt-4">{item.title}</h3>
              <p class="mt-1.5 text-[15px] text-muted">{item.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-20 rounded-box bg-base-200 p-6 sm:p-10">
      <div class="max-w-2xl" data-reveal>
        <p class="t-label text-primary">{process.eyebrow}</p>
        <h2 id="home-process" class="t-h2 mt-2">{process.title}</h2>
        <span class="accent-bar" aria-hidden="true"></span>
      </div>
      <ol class="relative mt-10 grid gap-8 md:grid-cols-4 md:gap-6" data-reveal-group="80">
        <div class="absolute left-5 right-5 top-5 hidden h-px bg-base-300 md:block" aria-hidden="true"></div>
        {
          process.steps.map((step, i) => (
            <li class="relative flex gap-4 md:block" data-reveal>
              <span class="relative z-10 flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-content ring-4 ring-base-200">
                {i + 1}
              </span>
              <div>
                <h3 class="t-h3 md:mt-4">{step.title}</h3>
                <p class="mt-1 text-[15px] text-muted">{step.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
