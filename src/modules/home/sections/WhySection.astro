---
import SectionHeading from '@shared/components/SectionHeading.astro';
import Icon, { type IconName } from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { why, process } = homeText[locale];
const icons: IconName[] = ['layers', 'search', 'shield', 'zap'];
---

<section class="section bg-base-200" aria-labelledby="home-why">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHeading id="home-why" index="03" eyebrow={why.eyebrow} title={why.title} description={why.desc} />
      </div>
      <ul class="grid gap-px border border-base-300 bg-base-300 sm:grid-cols-2 lg:col-span-7" data-reveal-group="90">
        {
          why.items.map((item, i) => (
            <li class="bg-base-100 p-6 sm:p-7" data-reveal>
              <span class="flex size-11 items-center justify-center bg-primary text-primary-content">
                <Icon name={icons[i % icons.length]!} class="size-5" />
              </span>
              <h3 class="t-h3 mt-6">{item.title}</h3>
              <p class="mt-2 text-[15px] text-base-content/65">{item.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Quy trình: timeline, đường kẻ chạy theo cuộn (scroll-driven) -->
    <div class="mt-20 sm:mt-28">
      <div data-reveal>
        <p class="eyebrow">{process.eyebrow}</p>
        <h2 id="home-process" class="t-h2 mt-4 max-w-2xl">{process.title}</h2>
      </div>
      <div class="relative mt-12 sm:mt-14">
        <div class="absolute bottom-0 left-5 top-0 w-px bg-base-300 md:bottom-auto md:left-0 md:right-0 md:top-5 md:h-px md:w-auto" aria-hidden="true"></div>
        <div class="process-line absolute left-0 right-0 top-5 hidden h-px bg-primary md:block" aria-hidden="true"></div>
        <ol class="relative grid gap-9 md:grid-cols-4 md:gap-6" data-reveal-group="140">
          {
            process.steps.map((step, i) => (
              <li class="relative grid grid-cols-[2.5rem_1fr] gap-x-5 md:block" data-reveal>
                <span class="num relative z-10 flex size-10 items-center justify-center bg-neutral text-sm font-semibold text-neutral-content ring-8 ring-base-200">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="t-h3 md:mt-6">{step.title}</h3>
                  <p class="mt-2 text-[15px] text-base-content/65">{step.desc}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
