---
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import NewsCard from '@modules/news/components/NewsCard.astro';
import { getNews } from '@modules/news/api';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const text = homeText[locale].news;
const posts = await getNews(locale, 3);
---

{
  posts.length > 0 && (
    <section class="container-x pb-14 sm:pb-20" aria-labelledby="home-news">
      <div class="frame flex flex-col items-center gap-4 px-6 py-10 text-center sm:flex-row sm:justify-between sm:text-left" data-reveal>
        <h2 id="home-news" class="t-h2">{text.title}</h2>
        <a href={localizePath('/news', locale)} class="btn btn-line btn-sm">{t('cta.viewAll')} <Icon name="arrowRight" class="arrow size-4" /></a>
      </div>
      <div class="frame border-t-0! grid gap-4 p-4 sm:grid-cols-2 sm:p-6 lg:grid-cols-3" data-reveal-group="80">
        {posts.map((p) => <NewsCard post={p} locale={locale} />)}
      </div>
    </section>
  )
}
