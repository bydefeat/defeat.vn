---
/**
 * Hero: canvas dither tương tác (logo DEFEAT lắp ghép từ pixel + trường nhiễu trôi chậm + vùng sáng theo con trỏ).
 * Không JS / reduced motion: logo dither tĩnh (PNG trong /public/brand).
 */
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath } from '@i18n/utils';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { hero, stats } = homeText[locale];
---

<section class="on-dark relative isolate overflow-hidden bg-neutral text-neutral-content" aria-labelledby="hero-title">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <img
      src="/brand/defeat_logo_dither.png"
      alt=""
      width="760"
      height="760"
      class="pixelated absolute right-[4%] top-1/2 hidden w-[36%] max-w-[540px] -translate-y-1/2 lg:block [.is-live>&]:hidden"
    />
    <canvas data-dither="hero" data-src="/brand/defeat_logo.png" class="pixelated absolute inset-0 size-full"></canvas>
  </div>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-r from-neutral via-neutral/80 to-transparent max-lg:bg-gradient-to-b max-lg:from-transparent max-lg:from-[150px] max-lg:via-neutral/90 max-lg:via-[230px] max-lg:to-neutral" aria-hidden="true"></div>
  <div class="grid-lines pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>

  <div class="container-x relative flex flex-col justify-center pb-14 pt-44 sm:pb-20 sm:pt-52 lg:min-h-[calc(100svh-var(--header-h)-2.25rem)] lg:py-20">
    <div class="max-w-3xl">
      <p class="eyebrow hero-in">{hero.eyebrow}</p>
      <h1 id="hero-title" class="t-display mt-6">
        <span class="reveal-text block">{hero.title}</span>
        <span class="reveal-text reveal-text-d1 block text-primary">{hero.highlight}</span>
      </h1>
      <p class="t-lead hero-in hero-in-d2 mt-7 max-w-xl text-neutral-content/70">{hero.desc}</p>
      <div class="hero-in hero-in-d3 mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={localizePath('/contact', locale)} class="btn btn-primary btn-lg" data-magnetic="0.15">
          {hero.primary} <Icon name="arrowRight" class="arrow size-5" />
        </a>
        <a href={localizePath('/products', locale)} class="btn btn-lg btn-outline btn-dither tone-dark border-white/25 text-neutral-content">
          {hero.secondary}
        </a>
      </div>
      <ul class="hero-in hero-in-d4 mt-9 flex flex-col gap-2.5 text-sm text-neutral-content/65 sm:flex-row sm:flex-wrap sm:gap-x-7">
        {hero.bullets.map((b) => <li class="flex items-center gap-2.5"><Icon name="check" class="size-4 text-primary" />{b}</li>)}
      </ul>
    </div>
  </div>

  <div class="relative border-t border-white/10 bg-neutral/70 backdrop-blur-sm">
    <dl class="container-x grid grid-cols-2 md:grid-cols-4" data-reveal-group="100">
      {
        stats.map((s, i) => (
          <div class:list={['flex flex-col-reverse justify-end gap-1.5 border-white/10 py-6 sm:py-8', i % 2 === 1 ? 'pl-5 max-md:border-l' : 'pr-5', 'md:px-8 md:first:pl-0', i > 0 && 'md:border-l', i > 1 && 'max-md:border-t']} data-reveal>
            <dt class="text-[13px] leading-snug text-neutral-content/55">{s.label}</dt>
            <dd class="num text-4xl font-semibold text-neutral-content sm:text-5xl" data-count>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
