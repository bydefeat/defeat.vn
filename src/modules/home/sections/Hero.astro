---
/** Hero: vệt sáng chéo, nhãn viên thuốc, tiêu đề lớn căn giữa, 2 nút, dải số liệu trong lưới nét đứt. */
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath } from '@i18n/utils';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { hero, stats } = homeText[locale];
---

<section class="vt-hero relative overflow-hidden" aria-labelledby="hero-title">
  <div class="beams" aria-hidden="true"></div>
  <div class="container-x relative">
    <div class="frame-l frame-r px-4 pb-16 pt-16 text-center sm:pb-20 sm:pt-24">
      <p class="frame mx-auto inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs text-muted">
        <span class="size-1.5 rounded-full bg-primary"></span>{hero.eyebrow}
      </p>
      <h1 id="hero-title" class="t-display mx-auto mt-7 max-w-4xl">
        {hero.title} <span class="text-muted">{hero.highlight}</span>
      </h1>
      <p class="t-lead mx-auto mt-6 max-w-xl text-muted">{hero.desc}</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={localizePath('/contact', locale)} class="btn btn-invert btn-lg">
          {hero.primary} <Icon name="arrowRight" class="arrow size-5" />
        </a>
        <a href={localizePath('/products', locale)} class="btn btn-line btn-lg">{hero.secondary}</a>
      </div>
      <ul class="mt-9 flex flex-col items-center justify-center gap-2 text-sm text-muted sm:flex-row sm:gap-6">
        {hero.bullets.map((b) => <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-base-content" />{b}</li>)}
      </ul>
    </div>
    <dl class="cells grid grid-cols-2 md:grid-cols-4">
      {
        stats.map((s) => (
          <div class="flex flex-col gap-1 px-5 py-6 sm:px-7">
            <dd class="text-3xl font-medium tracking-tight">{s.value}</dd>
            <dt class="text-[13px] leading-snug text-muted">{s.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>
