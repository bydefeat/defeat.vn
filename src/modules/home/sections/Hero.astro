---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/defeat_logo.png';
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath } from '@i18n/utils';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { hero, stats } = homeText[locale];
---

<section class="relative overflow-hidden bg-neutral text-neutral-content">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(232,32,36,0.35),transparent_55%)]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true"></div>

  <div class="container-x relative grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight text-balance sm:text-5xl lg:text-6xl">
        {hero.title} <span class="text-primary">{hero.highlight}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-neutral-content/75 text-pretty">{hero.desc}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={localizePath('/contact', locale)} class="btn btn-primary btn-lg">{hero.primary}</a>
        <a href={localizePath('/products', locale)} class="btn btn-lg btn-outline border-white/30 text-neutral-content hover:border-primary hover:bg-primary">{hero.secondary}</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-neutral-content/75">
        {hero.bullets.map((b) => <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-primary" />{b}</li>)}
      </ul>
    </div>
    <div class="hidden justify-center lg:col-span-5 lg:flex">
      <Image src={logo} alt="" width={380} height={380} class="w-80 drop-shadow-[0_20px_60px_rgba(232,32,36,0.45)]" loading="eager" fetchpriority="high" />
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <dl class="container-x grid grid-cols-2 divide-white/10 py-8 md:grid-cols-4 md:divide-x">
      {
        stats.map((s) => (
          <div class="flex flex-col-reverse px-4 py-3 md:px-8">
            <dt class="mt-1 text-sm text-neutral-content/60">{s.label}</dt>
            <dd class="text-3xl font-extrabold text-neutral-content">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
