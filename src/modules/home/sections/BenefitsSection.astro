---
/** Lợi ích: tiêu đề trong khung + lưới 2×2 các ô minh hoạ isometric nét chấm. */
import Illustration from '@shared/components/Illustration.astro';
import type { Locale } from '@i18n/config';
import { landing } from '../landing';
interface Props { locale: Locale }
const { benefits } = landing[Astro.props.locale];
const accents = ['teal', 'violet', 'sky', 'yellow'] as const;
---

<section class="container-x section" aria-labelledby="home-benefits">
  <div class="frame px-6 py-10 text-center" data-reveal>
    <h2 id="home-benefits" class="t-h2">{benefits.title}</h2>
  </div>
  <ul class="cells grid border-t-0! sm:grid-cols-2" data-reveal-group="80">
    {
      benefits.items.map((b, i) => (
        <li class="group relative flex flex-col justify-end overflow-hidden px-6 pb-7 pt-6 sm:min-h-[420px] sm:px-8" data-illo-hover tabindex="0" data-reveal>
          <div class="flex flex-1 items-center justify-center py-4">
            <Illustration name={b.illo} accent={accents[i % accents.length]} class="w-full max-w-[440px]" />
          </div>
          <h3 class="t-h3 text-xl">{b.title}</h3>
          <div class="reveal-desc"><p class="pt-1.5 text-sm text-muted">{b.desc}</p></div>
        </li>
      ))
    }
  </ul>
</section>
