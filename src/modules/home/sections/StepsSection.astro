---
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath } from '@i18n/utils';
import { landing } from '../landing';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { steps } = landing[locale];
const { ui } = steps;
---

<section class="container-x pb-14 sm:pb-20" aria-labelledby="home-steps">
  <div class="frame px-6 py-10 text-center sm:py-12" data-reveal>
    <h2 id="home-steps" class="t-h2">{steps.title}</h2>
    <p class="mx-auto mt-3 max-w-md text-muted">{steps.desc}</p>
  </div>

  <ol class="flow cells grid border-t-0! md:grid-cols-3" data-steps>
    {
      steps.items.map((s, i) => (
        <li class="fstep" data-state="done" data-reveal>
          <div class="step-head">
            <span class="step-node">
              <span class="node-icon"><Icon name={s.icon} class="size-[18px]" /></span>
              <span class="node-check"><Icon name="check" class="size-[18px]" /></span>
            </span>
            {i < steps.items.length - 1 && <span class="step-link" aria-hidden="true"><span class="step-link-fill" /></span>}
          </div>

          <div class="mt-6 flex items-center gap-3 text-[13px]">
            <span class="step-no">0{i + 1}</span>
            <span class="step-time"><Icon name="clock" class="size-3.5" />{s.time}</span>
          </div>
          <h3 class="mt-2 text-lg font-medium">{s.title}</h3>
          <p class="mt-1 text-sm text-muted">{s.desc}</p>

          <div class="step-visual dot-grid" aria-hidden="true">
            {i === 0 && (
              <div class="v-card v-req">
                <span class="v-chip">{ui.to}</span>
                <span class="v-line" />
                <span class="v-line" />
                <span class="v-line" />
                <span class="v-send">
                  <span class="v-send-a">{ui.send}<Icon name="arrowRight" class="size-3" /></span>
                  <span class="v-send-b"><Icon name="check" class="size-3" />{ui.sent}</span>
                </span>
              </div>
            )}
            {i === 1 && (
              <div class="v-card v-quote">
                <div class="v-quote-head"><span>{ui.quote}</span><span class="v-chip">{s.time}</span></div>
                {[ui.scope, ui.timeline, ui.cost].map((label) => (
                  <div class="v-quote-row">
                    <span>{label}</span>
                    <span class="v-leader" />
                    <span class="v-tick"><Icon name="check" class="size-3" /></span>
                  </div>
                ))}
                <div class="v-gantt">
                  <span />
                  <span />
                  <span />
                </div>
              </div>
            )}
            {i === 2 && (
              <div class="v-card v-build">
                <div class="v-bars">
                  {[1, 2, 3, 4].map((b) => (
                    <span class="v-bar">
                      <span class="v-bar-fill" />
                      <span class="v-bar-label">{ui.sprint}{b}</span>
                    </span>
                  ))}
                </div>
                <span class="v-badge"><Icon name="check" class="size-3" />{ui.handover}</span>
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <div class="frame frame-t-0 flex justify-center px-6 py-6">
    <a href={localizePath('/contact', locale)} class="btn btn-invert">{steps.cta} <Icon name="arrowRight" class="arrow size-4" /></a>
  </div>
</section>

<style>
  .frame-t-0 { border-top: 0; }

  .fstep {
    position: relative;
    padding: 2rem 1.5rem 1.75rem;
    transition: background-color 0.5s;
  }
  @media (min-width: 640px) { .fstep { padding: 2.5rem 2rem 2rem; } }
  .fstep[data-state='active'] { background-color: color-mix(in oklab, var(--color-primary) 4%, transparent); }

  .step-head { height: 44px; }
  @media (max-width: 767.98px) {
    .fstep { display: grid; grid-template-columns: 44px minmax(0, 1fr); column-gap: 16px; }
    .step-head { grid-row: 1 / span 4; }
    .fstep > :not(.step-head) { grid-column: 2; }
    .fstep > .step-head + div { margin-top: 12px; }
  }
  .step-node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--color-base-100);
    color: var(--muted);
    transition: background-color 0.45s, border-color 0.45s, color 0.45s, box-shadow 0.45s;
  }
  .step-node > span { grid-area: 1 / 1; display: grid; place-items: center; transition: opacity 0.3s, transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.3); }
  .node-check { opacity: 0; transform: scale(0.4); }
  .fstep[data-state='active'] .step-node {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: color-mix(in oklab, var(--color-primary) 12%, var(--color-base-100));
    box-shadow: 0 0 0 6px color-mix(in oklab, var(--color-primary) 10%, transparent), 0 0 28px var(--glow);
  }
  .fstep[data-state='active'] .step-node::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid var(--color-primary);
    animation: node-ring 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes node-ring { from { transform: scale(1); opacity: 0.7; } to { transform: scale(2.1); opacity: 0; } }
  .fstep[data-state='done'] .step-node { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-primary-content); }
  .fstep[data-state='done'] .node-icon { opacity: 0; transform: scale(0.4); }
  .fstep[data-state='done'] .node-check { opacity: 1; transform: none; }

  .step-link {
    position: absolute;
    --pt: 2rem;
    --px: 1.5rem;
    left: calc(var(--px) + 21px);
    top: calc(var(--pt) + 56px);
    bottom: calc(12px - var(--pt));
    width: 2px;
    background-image: linear-gradient(180deg, var(--line-strong) 50%, transparent 0);
    background-size: 2px 8px;
  }
  @media (min-width: 640px) { .step-link { --pt: 2.5rem; --px: 2rem; } }
  @media (min-width: 768px) {
    .step-link {
      left: calc(var(--px) + 56px);
      right: calc(12px - var(--px));
      top: calc(var(--pt) + 21px);
      bottom: auto;
      width: auto;
      height: 2px;
      background-image: linear-gradient(90deg, var(--line-strong) 50%, transparent 0);
      background-size: 8px 2px;
    }
  }
  .step-link-fill {
    position: absolute;
    inset: 0;
    transform-origin: top;
    transform: scaleY(0);
    background: linear-gradient(180deg, color-mix(in oklab, var(--color-primary) 30%, transparent), var(--color-primary));
    transition: transform 0.35s ease;
  }
  .fstep[data-state='done'] .step-link-fill { transform: none; transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1); }
  .step-link-fill::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -3px;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 999px;
    background: var(--color-primary);
    box-shadow: 0 0 12px 3px var(--glow);
    opacity: 0;
  }
  .fstep[data-state='done'] .step-link-fill::after { animation: comet 1.05s ease both; }
  @keyframes comet { 0%, 85% { opacity: 1; } 100% { opacity: 0; } }
  @media (min-width: 768px) {
    .step-link-fill { transform-origin: left; transform: scaleX(0); background: linear-gradient(90deg, color-mix(in oklab, var(--color-primary) 30%, transparent), var(--color-primary)); }
    .step-link-fill::after { left: auto; right: -3px; bottom: auto; top: 50%; margin: -4px 0 0; }
  }

  .step-no { font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; transition: color 0.4s; }
  .fstep:not([data-state='todo']) .step-no { color: var(--color-primary); }
  .step-time { display: inline-flex; align-items: center; gap: 0.35rem; border: 1px dashed var(--line); border-radius: 999px; padding: 0.15rem 0.6rem; color: var(--muted); }

  .step-visual {
    position: relative;
    margin-top: 1.5rem;
    height: 172px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 14px;
  }
  .v-card {
    position: relative;
    width: min(100%, 248px);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: color-mix(in oklab, var(--color-base-100) 88%, transparent);
    padding: 12px;
    font-size: 11px;
    line-height: 1;
    color: var(--muted);
    transition: border-color 0.5s, box-shadow 0.5s;
  }
  .fstep[data-state='active'] .v-card { border-color: color-mix(in oklab, var(--color-primary) 45%, var(--line)); box-shadow: 0 10px 40px -18px var(--glow); }
  .v-chip { display: inline-flex; align-items: center; border-radius: 999px; padding: 4px 8px; background: color-mix(in oklab, var(--color-base-content) 7%, transparent); color: var(--color-base-content); font-weight: 500; }

  .v-req { display: flex; flex-direction: column; gap: 8px; }
  .v-req .v-chip { align-self: flex-start; margin-bottom: 2px; }
  .v-line {
    display: block;
    height: 6px;
    width: var(--w);
    border-radius: 99px;
    background: color-mix(in oklab, var(--color-base-content) 22%, transparent);
    transform-origin: left;
    transform: scaleX(0.08);
    opacity: 0.5;
    transition: transform 0.3s, opacity 0.3s;
  }
  .fstep:not([data-state='todo']) .v-line { transform: none; opacity: 1; transition: transform 0.55s cubic-bezier(0.3, 0.7, 0.2, 1) var(--d), opacity 0.3s var(--d); }
  .v-send {
    position: relative;
    align-self: flex-end;
    display: grid;
    margin-top: 4px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--color-base-content);
    font-weight: 500;
    overflow: hidden;
    transition: background-color 0.3s, border-color 0.3s, color 0.3s;
  }
  .v-send > span { grid-area: 1 / 1; display: inline-flex; align-items: center; justify-content: center; gap: 4px; padding: 6px 11px; transition: transform 0.3s, opacity 0.3s; }
  .v-send-b { transform: translateY(100%); opacity: 0; }
  .fstep:not([data-state='todo']) .v-send { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-primary-content); transition-delay: 1s; }
  .fstep:not([data-state='todo']) .v-send-a { transform: translateX(140%); opacity: 0; transition: transform 0.45s cubic-bezier(0.6, 0, 0.8, 0.4) 1.15s, opacity 0.2s 1.4s; }
  .fstep:not([data-state='todo']) .v-send-b { transform: none; opacity: 1; transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) 1.5s, opacity 0.3s 1.5s; }

  .v-quote { display: flex; flex-direction: column; gap: 6px; }
  .v-quote-head { display: flex; align-items: center; justify-content: space-between; color: var(--color-base-content); font-weight: 500; margin-bottom: 2px; }
  .v-quote-row { display: flex; align-items: center; gap: 6px; }
  .v-leader { flex: 1; height: 1px; background-image: linear-gradient(90deg, var(--line-strong) 50%, transparent 0); background-size: 4px 1px; }
  .v-tick {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: transparent;
    transition: all 0.3s;
  }
  .fstep:not([data-state='todo']) .v-tick { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-primary-content); transition: background-color 0.3s var(--d), border-color 0.3s var(--d), color 0.3s var(--d); }
  .fstep:not([data-state='todo']) .v-quote-row { color: var(--color-base-content); transition: color 0.3s var(--d); }
  .v-gantt { position: relative; display: grid; gap: 4px; margin-top: 4px; }
  .v-gantt > span {
    display: block;
    height: 5px;
    margin-left: var(--x);
    width: var(--w);
    border-radius: 99px;
    background: color-mix(in oklab, var(--color-base-content) 12%, transparent);
    position: relative;
    overflow: hidden;
  }
  .v-gantt > span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-primary);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.3s;
  }
  .fstep:not([data-state='todo']) .v-gantt > span::after { transform: none; transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.2, 1) var(--d); }

  .v-build { height: 136px; display: flex; flex-direction: column; }
  .v-bars { flex: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: end; padding: 30px 0 16px; }
  .v-bar { position: relative; height: var(--h); border-radius: 6px; background: color-mix(in oklab, var(--color-base-content) 8%, transparent); }
  .v-bar-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, var(--color-primary), color-mix(in oklab, var(--color-primary) 55%, transparent));
    transform-origin: bottom;
    transform: scaleY(0);
    transition: transform 0.3s;
  }
  .fstep:not([data-state='todo']) .v-bar-fill { transform: none; transition: transform 0.55s cubic-bezier(0.3, 0.7, 0.2, 1) var(--d); }
  .v-bar-label { position: absolute; left: 0; right: 0; bottom: -15px; text-align: center; font-size: 10px; }
  .v-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 999px;
    padding: 5px 9px;
    background: var(--color-base-content);
    color: var(--color-base-100);
    font-weight: 500;
    opacity: 0;
    transform: translateY(-6px) scale(0.9);
    transition: opacity 0.25s, transform 0.25s;
  }
  .fstep:not([data-state='todo']) .v-badge { opacity: 1; transform: none; transition: opacity 0.35s 1.35s, transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3) 1.35s; }


  .v-line:nth-of-type(2) { --w: 92%; --d: 0.15s; }
  .v-line:nth-of-type(3) { --w: 74%; --d: 0.4s; }
  .v-line:nth-of-type(4) { --w: 52%; --d: 0.65s; }
  .v-quote-row:nth-child(2) { --d: 0.2s; }
  .v-quote-row:nth-child(3) { --d: 0.5s; }
  .v-quote-row:nth-child(4) { --d: 0.8s; }
  .v-gantt > span:nth-child(1) { --x: 0%; --w: 38%; --d: 1.1s; }
  .v-gantt > span:nth-child(2) { --x: 26%; --w: 42%; --d: 1.3s; }
  .v-gantt > span:nth-child(3) { --x: 54%; --w: 46%; --d: 1.5s; }
  .v-bar:nth-child(1) { --h: 38%; --d: 0.15s; }
  .v-bar:nth-child(2) { --h: 58%; --d: 0.43s; }
  .v-bar:nth-child(3) { --h: 78%; --d: 0.71s; }
  .v-bar:nth-child(4) { --h: 100%; --d: 0.99s; }

  @media (prefers-reduced-motion: reduce) {
    .fstep *, .fstep *::before, .fstep *::after { transition: none !important; animation: none !important; }
  }
</style>
