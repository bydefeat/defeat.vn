---
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { landing } from '../landing';
interface Props { locale: Locale }
const { highlights, highlightsUi: ui } = landing[Astro.props.locale];
---

<ul class="frame-t grid grid-cols-2 md:grid-cols-4" data-reveal-group="70">
  {
    highlights.map((h, i) => (
      <li class:list={['hl flex flex-col px-4 py-7 sm:px-6 sm:py-8', i % 2 === 1 && 'frame-l', i > 1 && 'max-md:frame-t', i === 2 && 'md:frame-l']} data-reveal data-play>
        <div class="hl-visual dot-grid" aria-hidden="true">
          {h.fx === 'consult' && (
            <div class="fx-consult">
              <span class="fx-line" />
              <span class="fx-line" />
              <span class="fx-line" />
              <span class="fx-lens"><Icon name="search" class="size-4" /></span>
            </div>
          )}
          {h.fx === 'source' && (
            <div class="fx-source">
              <svg viewBox="0 0 64 64" class="fx-ring">
                <circle cx="32" cy="32" r="27" pathLength="100" class="fx-ring-track" />
                <circle cx="32" cy="32" r="27" pathLength="100" class="fx-ring-fill" />
              </svg>
              <span class="fx-pct" />
              <span class="fx-code"><Icon name="code" class="size-3.5" /></span>
            </div>
          )}
          {h.fx === 'security' && (
            <div class="fx-security">
              <svg viewBox="0 0 24 24" class="fx-shield">
                <path pathLength="1" class="fx-shield-path" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <path pathLength="1" class="fx-shield-check" d="M8.5 12l2.5 2.5 4.5-5" />
              </svg>
              <span class="fx-scan" />
              <span class="fx-nda">{ui.nda}</span>
            </div>
          )}
          {h.fx === 'support' && (
            <div class="fx-support">
              <span class="fx-track"><span class="fx-track-fill" /></span>
              {ui.milestones.map((m) => (
                <span class="fx-mile">
                  <span class="fx-dot" />
                  <span class="fx-mile-label">{m}</span>
                </span>
              ))}
              <span class="fx-more" />
            </div>
          )}
        </div>
        <h3 class="mt-5 text-[15px] font-medium">{h.title}</h3>
        <p class="mt-1 text-[13px] text-muted">{h.desc}</p>
      </li>
    ))
  }
</ul>

<style>
  @property --pct { syntax: '<integer>'; inherits: false; initial-value: 100; }

  .hl-visual {
    position: relative;
    height: 104px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    display: grid;
    place-items: center;
    overflow: hidden;
    transition: border-color 0.4s, background-color 0.4s;
  }
  .hl:hover .hl-visual { border-color: color-mix(in oklab, var(--color-primary) 45%, var(--line)); background-color: color-mix(in oklab, var(--color-primary) 4%, transparent); }

  .hl :is(.fx-lens, .fx-ring-fill, .fx-pct, .fx-code, .fx-shield-path, .fx-shield-check, .fx-scan, .fx-nda, .fx-track-fill, .fx-dot, .fx-mile-label, .fx-more),
  .hl .fx-line::after {
    animation-delay: calc(var(--stagger, 0s) + var(--d, 0s));
    animation-fill-mode: both;
    animation-duration: var(--t, 0.8s);
    animation-timing-function: cubic-bezier(0.3, 0.7, 0.2, 1);
    animation-play-state: running;
  }
  .hl[data-play-wait] *, .hl[data-play-wait] *::after { animation-play-state: paused !important; }
  .hl:not(.is-play):not([data-play-wait]) *, .hl:not(.is-play):not([data-play-wait]) *::after { animation-name: none !important; }

  .fx-consult { position: relative; width: 120px; display: grid; gap: 9px; }
  .fx-line { position: relative; display: block; width: var(--w); height: 6px; border-radius: 99px; background: color-mix(in oklab, var(--color-base-content) 16%, transparent); overflow: hidden; }
  .fx-line::after { content: ''; position: absolute; inset: 0; background: var(--color-primary); transform-origin: left; --t: 1.5s; animation-name: fx-grow; }
  .fx-lens {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: color-mix(in oklab, var(--color-base-100) 70%, transparent);
    backdrop-filter: blur(2px);
    color: var(--color-base-content);
    box-shadow: 0 6px 20px -8px var(--glow);
    transform: translateX(120px);
    --t: 1.5s;
    animation-name: fx-lens;
  }
  @keyframes fx-grow { from { transform: scaleX(0); } }
  @keyframes fx-lens { from { transform: translateX(0); } 70% { transform: translateX(122px); } to { transform: translateX(120px); } }

  .fx-source { position: relative; display: grid; place-items: center; width: 72px; height: 72px; }
  .fx-ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
  .fx-ring circle { fill: none; stroke-width: 3; }
  .fx-ring-track { stroke: var(--line); }
  .fx-ring-fill { stroke: var(--color-primary); stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 0; --t: 1.6s; animation-name: fx-ring; }
  @keyframes fx-ring { from { stroke-dashoffset: 100; } }
  .fx-pct { counter-reset: pct var(--pct); font-size: 15px; font-weight: 600; color: var(--color-base-content); font-variant-numeric: tabular-nums; --t: 1.6s; animation-name: fx-count; }
  .fx-pct::after { content: counter(pct) '%'; }
  @keyframes fx-count { from { --pct: 0; } }
  .fx-code {
    position: absolute;
    right: -6px;
    bottom: 2px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-primary-content);
    --d: 1.4s;
    --t: 0.5s;
    animation-name: fx-pop;
  }
  @keyframes fx-pop { from { transform: scale(0); opacity: 0; } 60% { transform: scale(1.15); opacity: 1; } }

  .fx-security { position: relative; display: grid; place-items: center; width: 100%; height: 100%; }
  .fx-shield { width: 54px; height: 54px; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .fx-shield-path { stroke: var(--color-base-content); stroke-width: 1.4; stroke-dasharray: 1; --t: 1.1s; animation-name: fx-draw; }
  .fx-shield-check { stroke: var(--color-primary); stroke-width: 2; stroke-dasharray: 1; --d: 1s; --t: 0.5s; animation-name: fx-draw; }
  @keyframes fx-draw { from { stroke-dashoffset: 1; } }
  .fx-scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 30%;
    background: linear-gradient(180deg, transparent, color-mix(in oklab, var(--color-primary) 22%, transparent) 85%, var(--color-primary) 100%);
    opacity: 0;
    --t: 1.2s;
    animation-name: fx-scan;
    animation-timing-function: ease-in-out;
  }
  @keyframes fx-scan { from { transform: translateY(-100%); opacity: 1; } 90% { opacity: 1; } to { transform: translateY(340%); opacity: 0; } }
  .fx-nda {
    position: absolute;
    right: 10px;
    bottom: 10px;
    border-radius: 999px;
    padding: 3px 8px;
    border: 1px solid var(--line-strong);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-base-content);
    background: var(--color-base-100);
    --d: 1.3s;
    --t: 0.5s;
    animation-name: fx-slide;
  }
  @keyframes fx-slide { from { transform: translateX(12px); opacity: 0; } }

  .fx-support { position: relative; display: grid; grid-template-columns: repeat(3, 1fr) 14px; align-items: start; width: min(100% - 16px, 190px); padding-top: 4px; }
  .fx-track { position: absolute; left: calc((100% - 14px) / 6); right: 0; top: 9px; height: 2px; background-image: linear-gradient(90deg, var(--line-strong) 50%, transparent 0); background-size: 6px 2px; }
  .fx-track-fill { position: absolute; inset: 0; right: 14px; background: var(--color-primary); transform-origin: left; --t: 1.4s; animation-name: fx-grow; animation-timing-function: linear; }
  .fx-mile { position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .fx-dot {
    width: 12px;
    height: 12px;
    margin-top: 0;
    border-radius: 999px;
    border: 2px solid var(--color-primary);
    background: var(--color-primary);
    box-shadow: 0 0 0 4px var(--color-base-100);
    --d: calc(var(--k) * 0.6s);
    --t: 0.35s;
    animation-name: fx-dot;
  }
  @keyframes fx-dot { from { background: var(--color-base-100); border-color: var(--line-strong); transform: scale(0.8); } }
  .fx-mile-label { font-size: 10px; color: var(--muted); white-space: nowrap; --d: calc(var(--k) * 0.6s); --t: 0.4s; animation-name: fx-slide-up; }
  @keyframes fx-slide-up { from { transform: translateY(4px); opacity: 0; } }
  .fx-more { position: relative; top: 5px; width: 10px; height: 10px; border-top: 2px solid var(--muted); border-right: 2px solid var(--muted); transform: rotate(45deg); --d: 1.4s; --t: 0.4s; animation-name: fx-fade; }
  @keyframes fx-fade { from { opacity: 0; } }


  .hl:nth-child(2) { --stagger: 0.15s; }
  .hl:nth-child(3) { --stagger: 0.3s; }
  .hl:nth-child(4) { --stagger: 0.45s; }
  .fx-line:nth-child(1) { --w: 84%; }
  .fx-line:nth-child(2) { --w: 62%; }
  .fx-line:nth-child(3) { --w: 74%; }
  .fx-mile:nth-of-type(2) { --k: 0; }
  .fx-mile:nth-of-type(3) { --k: 1; }
  .fx-mile:nth-of-type(4) { --k: 2; }

  @media (prefers-reduced-motion: reduce) {
    .hl *, .hl *::after { animation: none !important; }
  }
</style>
