---
import SectionHeading from '@shared/components/SectionHeading.astro';
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import ProductCard from '@modules/products/components/ProductCard.astro';
import { getProducts } from '@modules/products/api';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const text = homeText[locale].products;
const products = await getProducts(locale, { featured: true, limit: 3 });
---

{
  products.length > 0 && (
    <section class="section" aria-labelledby="home-products">
      <div class="container-x">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <SectionHeading index="02" id="home-products" eyebrow={text.eyebrow} title={text.title} description={text.desc} />
          <a href={localizePath('/products', locale)} class="btn btn-outline shrink-0" data-reveal>{t('cta.viewAll')} <Icon name="arrowRight" class="arrow size-4" /></a>
        </div>
        <div data-reveal-group="100" class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((p) => <ProductCard product={p} locale={locale} />)}
        </div>
      </div>
    </section>
  )
}
