---
import type { Locale } from '@i18n/config';
import { landing } from '../landing';
import { TECH_LOGOS } from '@shared/lib/tech-logos';
interface Props { locale: Locale }
const title = landing[Astro.props.locale].logosTitle;
---

<section class="container-x" aria-labelledby="home-tech">
  <div class="frame-l frame-r frame-b px-6 py-12 text-center">
    <h2 id="home-tech" class="text-sm text-muted">{title}</h2>
    <ul class="mx-auto mt-8 flex max-w-4xl flex-wrap items-center justify-center gap-x-9 gap-y-7" data-reveal-group="25">
      {
        TECH_LOGOS.map((logo) => (
          <li title={logo.name} data-reveal>
            <img src={`/tech/${logo.slug}.svg`} alt={logo.name} width="28" height="28" loading="lazy" decoding="async" class:list={['size-7 object-contain', logo.dark && 'only-light']} />
            {logo.dark && <img src={`/tech/${logo.slug}-dark.svg`} alt={logo.name} width="28" height="28" loading="lazy" decoding="async" class="only-dark size-7 object-contain" />}
          </li>
        ))
      }
    </ul>
  </div>
</section>
