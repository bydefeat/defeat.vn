---
import type { Locale } from '@i18n/config';
import { landing } from '../landing';
import { TECH_LOGOS } from '../data/tech-logos';
interface Props { locale: Locale }
const title = landing[Astro.props.locale].logosTitle;
---

<section class="container-x" aria-labelledby="home-tech">
  <div class="frame-l frame-r frame-b px-6 py-12 text-center">
    <h2 id="home-tech" class="text-sm text-muted">{title}</h2>
    <ul class="mx-auto mt-8 flex max-w-4xl flex-wrap items-center justify-center gap-x-9 gap-y-7" data-reveal-group="25">
      {
        TECH_LOGOS.map((logo) => (
          <li class="tech-item" data-brand={logo.color} title={logo.name} data-reveal>
            <svg viewBox={logo.viewBox} class="tech-logo size-7" fill="currentColor" fill-rule={logo.fillRule} role="img" aria-label={logo.name} set:html={logo.body} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
