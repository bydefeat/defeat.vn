---
/** Dịch vụ: bên trái tiêu đề + nút, bên phải danh sách dịch vụ 2 cột (icon + tiêu đề + mô tả). */
import SectionHeading from '@shared/components/SectionHeading.astro';
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import { SERVICES } from '@modules/services/data';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const text = homeText[locale].services;
---

<section class="section" aria-labelledby="home-services">
  <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <SectionHeading id="home-services" eyebrow={text.eyebrow} title={text.title} description={text.desc}>
        <a href={localizePath('/services', locale)} class="btn btn-primary mt-8">
          {t('cta.viewAll')} <Icon name="arrowRight" class="arrow size-4" />
        </a>
      </SectionHeading>
    </div>
    <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:col-span-7" data-reveal-group="60">
      {
        SERVICES.map((s) => (
          <li data-reveal>
            <a href={localizePath(`/services/${s.slug}`, locale)} class="group flex gap-4 rounded-box p-3 transition-colors hover:bg-base-200 sm:-mx-3">
              <span class="icon-chip"><Icon name={s.icon} class="size-5" /></span>
              <span>
                <span class="block font-bold transition-colors group-hover:text-primary">{s.title[locale]}</span>
                <span class="mt-1 block text-sm text-muted">{s.summary[locale]}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
