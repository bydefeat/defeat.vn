---
import SectionHeading from '@shared/components/SectionHeading.astro';
import Icon from '@shared/components/Icon.astro';
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import ServiceCard from '@modules/services/components/ServiceCard.astro';
import { SERVICES } from '@modules/services/data';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const text = homeText[locale].services;
---

<section class="section" aria-labelledby="home-services">
  <div class="container-x">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <SectionHeading id="home-services" index="01" eyebrow={text.eyebrow} title={text.title} description={text.desc} />
      <a href={localizePath('/services', locale)} class="btn btn-outline shrink-0" data-reveal>
        {t('cta.viewAll')} <Icon name="arrowRight" class="arrow size-4" />
      </a>
    </div>
    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group="90">
      {SERVICES.map((s, i) => <ServiceCard service={s} locale={locale} index={i} total={SERVICES.length} />)}
    </div>
  </div>
</section>
