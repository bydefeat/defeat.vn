---
/** FAQ dùng <details> gốc (không JS), mở/đóng có animation chiều cao. JSON-LD FAQPage do HomePage thêm. */
import SectionHeading from '@shared/components/SectionHeading.astro';
import type { Locale } from '@i18n/config';
import { homeText } from '../i18n';
interface Props { locale: Locale }
const { faq } = homeText[Astro.props.locale];
---

<section class="section border-t border-base-300" aria-labelledby="home-faq">
  <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-4">
      <SectionHeading id="home-faq" index="06" eyebrow={faq.eyebrow} title={faq.title} />
    </div>
    <div class="border-t border-base-300 lg:col-span-8" data-reveal-group="80">
      {
        faq.items.map((item, i) => (
          <details class="faq-item group border-b border-base-300" open={i === 0} data-reveal>
            <summary class="flex cursor-pointer list-none items-start gap-4 py-5 sm:gap-6 sm:py-6">
              <span class="num mt-0.5 w-6 shrink-0 text-sm font-semibold text-base-content/35 group-open:text-primary">{String(i + 1).padStart(2, '0')}</span>
              <span class="t-h3 flex-1 transition-colors group-hover:text-primary">{item.q}</span>
              <span class="relative mt-0.5 flex size-8 shrink-0 items-center justify-center border border-base-300 transition-colors group-open:border-primary group-open:bg-primary group-open:text-primary-content" aria-hidden="true">
                <span class="absolute h-0.5 w-3 bg-current"></span>
                <span class="bar-v absolute h-3 w-0.5 bg-current"></span>
              </span>
            </summary>
            <div class="pb-6 pl-10 pr-2 text-[15px] text-base-content/70 sm:pl-12 sm:pr-14"><p>{item.a}</p></div>
          </details>
        ))
      }
    </div>
  </div>
</section>
