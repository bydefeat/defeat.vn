---
/** FAQ: <details> gốc (không JS). JSON-LD FAQPage do HomePage thêm. */
import SectionHeading from '@shared/components/SectionHeading.astro';
import type { Locale } from '@i18n/config';
import { homeText } from '../i18n';
interface Props { locale: Locale }
const { faq } = homeText[Astro.props.locale];
---

<section class="section bg-base-200" aria-labelledby="home-faq">
  <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <SectionHeading id="home-faq" eyebrow={faq.eyebrow} title={faq.title} />
    </div>
    <div class="space-y-3 lg:col-span-8" data-reveal-group="60">
      {
        faq.items.map((item, i) => (
          <details class="faq-item group rounded-box border border-base-300 bg-base-100" open={i === 0} data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold transition-colors hover:text-primary sm:px-6">
              {item.q}
              <svg class="chev size-5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </summary>
            <div class="px-5 pb-5 text-[15px] text-muted sm:px-6"><p>{item.a}</p></div>
          </details>
        ))
      }
    </div>
  </div>
</section>
