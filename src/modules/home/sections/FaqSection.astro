---
import type { Locale } from '@i18n/config';
import { homeText } from '../i18n';
interface Props { locale: Locale }
const { faq } = homeText[Astro.props.locale];
---

<section class="container-x pb-6" aria-labelledby="home-faq">
  <div class="frame grid md:grid-cols-[2fr_3fr]">
    <div class="px-6 py-8 max-md:frame-b md:frame-r sm:px-8" data-reveal>
      <h2 id="home-faq" class="t-h2 max-w-[12ch]">{faq.title}</h2>
    </div>
    <div>
      {
        faq.items.map((item, i) => (
          <details class:list={['faq-item group', i > 0 && 'frame-t']} open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 transition-colors hover:bg-base-200 sm:px-8">
              <span class="text-[15px]">{item.q}</span>
              <span class="relative flex size-4 shrink-0 items-center justify-center text-muted" aria-hidden="true">
                <span class="absolute h-px w-4 bg-current" />
                <span class="plus-v absolute h-4 w-px bg-current" />
              </span>
            </summary>
            <div class="px-6 pb-6 text-[15px] text-muted sm:px-8"><p>{item.a}</p></div>
          </details>
        ))
      }
    </div>
  </div>
</section>
