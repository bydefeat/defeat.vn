---
import SectionHeading from '@shared/components/SectionHeading.astro';
import type { Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';
import CaseStudyCard from '@modules/case-studies/components/CaseStudyCard.astro';
import { getCaseStudies } from '@modules/case-studies/api';
import { homeText } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const text = homeText[locale].cases;
const items = await getCaseStudies(locale, { featured: true, limit: 2 });
---

{
  items.length > 0 && (
    <section class="section bg-base-200" aria-labelledby="home-cases">
      <div class="container-x">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <SectionHeading id="home-cases" eyebrow={text.eyebrow} title={text.title} description={text.desc} />
          <a href={localizePath('/case-studies', locale)} class="btn btn-outline btn-sm shrink-0">{t('cta.viewAll')}</a>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          {items.map((item) => <CaseStudyCard item={item} locale={locale} />)}
        </div>
      </div>
    </section>
  )
}
