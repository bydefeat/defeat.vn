---
import { Image } from 'astro:assets';
import Icon from '@shared/components/Icon.astro';
import { LOCALE_META, type Locale } from '@i18n/config';
import { entryLocale } from '@shared/lib/content';
import { formatDate, localizePath, useTranslations } from '@i18n/utils';
import { newsPath, type NewsEntry } from '../api';

interface Props { post: NewsEntry; locale: Locale; headingLevel?: 'h2' | 'h3' }
const { post, locale, headingLevel: H = 'h3' } = Astro.props;
const t = useTranslations(locale);
const { data } = post;
// Bản dự phòng (chưa dịch) → khai báo đúng ngôn ngữ của tiêu đề/tóm tắt.
const contentLang = entryLocale(post) !== locale ? LOCALE_META[entryLocale(post)].hreflang : undefined;
const href = localizePath(newsPath(post), locale);
---

<article class="card-base card-hover" data-reveal lang={contentLang}>
  <div class="aspect-[16/9] overflow-hidden">
    {
      data.cover ? (
        <Image src={data.cover} alt={data.coverAlt ?? data.title} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="card-img size-full object-cover" />
      ) : (
        <div class="cover-placeholder size-full"><Icon name="clipboard" class="size-10" /></div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2 text-[13px] text-muted">
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time>
      {data.tags[0] && <><span aria-hidden="true">·</span><span class="font-semibold text-accent">{data.tags[0]}</span></>}
    </div>
    <H class="card-title t-h3 mt-2">
      <a href={href} class="after:absolute after:inset-0">{data.title}</a>
    </H>
    <p class="mt-2 line-clamp-3 flex-1 text-[15px] text-muted">{data.description}</p>
    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
      {t('cta.readMore')} <Icon name="arrowRight" class="size-4" />
    </span>
  </div>
</article>
