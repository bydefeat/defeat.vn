---
import { Image } from 'astro:assets';
import type { Locale } from '@i18n/config';
import { formatDate, localizePath } from '@i18n/utils';
import { newsPath, type NewsEntry } from '../api';

interface Props { post: NewsEntry; locale: Locale; headingLevel?: 'h2' | 'h3' }
const { post, locale, headingLevel: H = 'h3' } = Astro.props;
const { data } = post;
const href = localizePath(newsPath(post), locale);
---

<article class="group relative flex flex-col">
  <div class="aspect-[16/9] overflow-hidden rounded-box bg-base-200">
    {
      data.cover ? (
        <Image src={data.cover} alt={data.coverAlt ?? data.title} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="size-full object-cover transition duration-300 group-hover:scale-105" />
      ) : (
        <div class="flex size-full items-end bg-gradient-to-br from-base-300 to-primary/20 p-5">
          <span class="line-clamp-2 text-lg font-bold text-base-content/70">{data.title}</span>
        </div>
      )
    }
  </div>
  <div class="mt-4 flex items-center gap-2 text-xs text-base-content/60">
    <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time>
    {data.tags[0] && <><span aria-hidden="true">·</span><span class="text-primary">{data.tags[0]}</span></>}
  </div>
  <H class="mt-2 text-lg font-semibold leading-snug group-hover:text-primary">
    <a href={href} class="after:absolute after:inset-0">{data.title}</a>
  </H>
  <p class="mt-2 line-clamp-2 text-sm text-base-content/70">{data.description}</p>
</article>
