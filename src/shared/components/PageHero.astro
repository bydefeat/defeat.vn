---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';
import UntranslatedNote from './UntranslatedNote.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  crumbs: Crumb[];
  untranslated?: boolean;
}
const { eyebrow, title, description, crumbs, untranslated = false } = Astro.props;
---

<section class="vt-hero relative overflow-hidden">
  <div class="beams opacity-70" aria-hidden="true"></div>
  <div class="container-x relative">
    <div class="frame-l frame-r frame-b px-5 pb-12 pt-10 sm:px-8 sm:pb-16 sm:pt-14">
      <Breadcrumbs items={crumbs} />
      {untranslated && <div class="mt-6"><UntranslatedNote /></div>}
      {eyebrow && <p class="t-label mt-10 text-primary">{eyebrow}</p>}
      <h1 class:list={['vt-title t-h1 max-w-4xl', eyebrow ? 'mt-3' : 'mt-10']}>{title}</h1>
      {description && <p class="t-lead mt-5 max-w-2xl text-muted">{description}</p>}
      <slot />
    </div>
  </div>
</section>
