---
/** Hero cho các trang con: breadcrumb + h1 + mô tả. */
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  crumbs: Crumb[];
}
const { eyebrow, title, description, crumbs } = Astro.props;
---

<section class="border-b border-base-300 bg-base-200">
  <div class="container-x py-12 sm:py-16">
    <Breadcrumbs items={crumbs} />
    {eyebrow && <p class="eyebrow mt-6">{eyebrow}</p>}
    <h1 class="mt-3 max-w-4xl text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">{title}</h1>
    {description && <p class="mt-5 max-w-3xl text-lg text-base-content/70 text-pretty">{description}</p>}
    <slot />
  </div>
</section>
