---
/**
 * Minh hoạ isometric nét chấm (tranh gốc DEFEAT, sinh bởi scripts/generate-illustrations.mjs).
 * Nhúng SVG trực tiếp để nét vẽ dùng currentColor → tự đổi theo theme sáng/tối.
 */
const files = import.meta.glob<string>('/src/assets/illustrations/*.svg', { query: '?raw', import: 'default', eager: true });
interface Props { name: string; class?: string; label?: string }
const { name, class: className, label } = Astro.props;
const svg = files[`/src/assets/illustrations/${name}.svg`] ?? '';
---

<div class:list={['[&>svg]:block', className]} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={svg} />
