---
import Icon from '@shared/components/Icon.astro';
import { resolveLocale } from '@i18n/utils';

const TEXT = {
  vi: {
    dialog: 'Xem ảnh',
    open: 'Phóng to ảnh',
    badge: 'Phóng to',
    close: 'Đóng (Esc)',
    prev: 'Ảnh trước (←)',
    next: 'Ảnh sau (→)',
    zoomIn: 'Phóng to (+)',
    zoomOut: 'Thu nhỏ (−)',
    reset: 'Vừa màn hình / kích thước thật (0)',
    hintMouse: 'Bấm hoặc cuộn chuột trên ảnh để phóng to · Kéo để di chuyển · ← → để chuyển ảnh',
    hintTouch: 'Chạm 2 lần hoặc chụm để phóng to · Vuốt ngang để chuyển ảnh · Vuốt xuống để đóng',
  },
  en: {
    dialog: 'Image viewer',
    open: 'Enlarge image',
    badge: 'Zoom',
    close: 'Close (Esc)',
    prev: 'Previous image (←)',
    next: 'Next image (→)',
    zoomIn: 'Zoom in (+)',
    zoomOut: 'Zoom out (−)',
    reset: 'Fit to screen / actual size (0)',
    hintMouse: 'Click or scroll on the image to zoom · Drag to pan · ← → to switch images',
    hintTouch: 'Double-tap or pinch to zoom · Swipe sideways to switch · Swipe down to close',
  },
};
const text = TEXT[resolveLocale(Astro.currentLocale)];
---

<template data-lb-badge>
  <span class="lb-badge" aria-hidden="true"><Icon name="zoomIn" class="size-4" /><span>{text.badge}</span></span>
</template>

<dialog class="lb" aria-label={text.dialog} data-lb data-open-label={text.open}>
  <div class="lb-bg" data-bg></div>

  <div class="lb-stage" data-stage>
    <div class="lb-frame" data-frame>
      <img data-img alt="" draggable="false" decoding="async" />
    </div>
  </div>

  <div class="lb-chrome lb-top">
    <p class="lb-counter tabular-nums" aria-live="polite">
      <span data-counter></span>
      <span class="lb-spin" data-spin aria-hidden="true"></span>
    </p>
    <div class="lb-tools">
      <button type="button" class="lb-btn" data-zoom-out aria-label={text.zoomOut} title={text.zoomOut}><Icon name="minus" class="size-5" /></button>
      <button type="button" class="lb-btn lb-pct tabular-nums" data-zoom-reset aria-label={text.reset} title={text.reset}>100%</button>
      <button type="button" class="lb-btn" data-zoom-in aria-label={text.zoomIn} title={text.zoomIn}><Icon name="plus" class="size-5" /></button>
      <span class="lb-sep" aria-hidden="true"></span>
      <button type="button" class="lb-btn" data-close aria-label={text.close} title={text.close} autofocus><Icon name="x" class="size-5" /></button>
    </div>
  </div>

  <button type="button" class="lb-chrome lb-btn lb-nav lb-prev" data-prev aria-label={text.prev} title={text.prev}><Icon name="chevronLeft" class="size-6" /></button>
  <button type="button" class="lb-chrome lb-btn lb-nav lb-next" data-next aria-label={text.next} title={text.next}><Icon name="chevronRight" class="size-6" /></button>

  <div class="lb-chrome lb-bottom">
    <p class="lb-hint" data-hint>
      <span class="lb-hint-mouse">{text.hintMouse}</span>
      <span class="lb-hint-touch">{text.hintTouch}</span>
    </p>
    <p class="lb-caption" data-caption></p>
  </div>
</dialog>

<script>
  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  function largestSrc(img: HTMLImageElement): string {
    let best = img.currentSrc || img.src;
    let bestW = 0;
    for (const part of img.srcset.split(',')) {
      const [url, w] = part.trim().split(/\s+/);
      const n = parseFloat(w ?? '');
      if (url && n > bestW) { bestW = n; best = url; }
    }
    return new URL(best, location.href).href;
  }

  function init(dlg: HTMLDialogElement, root: Element) {
    const thumbs = [...root.querySelectorAll<HTMLImageElement>('img')];
    if (!thumbs.length) return;
    const q = <T extends Element>(s: string) => dlg.querySelector<T>(s)!;
    const bg = q<HTMLElement>('[data-bg]');
    const stage = q<HTMLElement>('[data-stage]');
    const frame = q<HTMLElement>('[data-frame]');
    const img = q<HTMLImageElement>('[data-img]');
    const counter = q<HTMLElement>('[data-counter]');
    const caption = q<HTMLElement>('[data-caption]');
    const pct = q<HTMLButtonElement>('[data-zoom-reset]');
    const zoomInBtn = q<HTMLButtonElement>('[data-zoom-in]');
    const zoomOutBtn = q<HTMLButtonElement>('[data-zoom-out]');
    const hint = q<HTMLElement>('[data-hint]');
    const badge = document.querySelector<HTMLTemplateElement>('template[data-lb-badge]');
    const single = thumbs.length === 1;
    dlg.classList.toggle('is-single', single);

    let idx = 0, s = 1, tx = 0, ty = 0, fit = 1, natW = 0, natH = 0, fitW = 0, fitH = 0, maxS = 3;
    let closing = false, hintShown = false, hintTimer = 0, wheelTimer = 0;

    thumbs.forEach((t, i) => {
      const wrap = document.createElement('span');
      wrap.className = 'lb-thumb';
      wrap.style.margin = getComputedStyle(t).margin;
      t.style.margin = '0';
      t.before(wrap);
      wrap.append(t);
      if (badge) wrap.append(badge.content.cloneNode(true));
      t.tabIndex = 0;
      t.setAttribute('role', 'button');
      t.setAttribute('aria-haspopup', 'dialog');
      t.setAttribute('aria-label', `${dlg.dataset.openLabel}: ${t.alt}`);
      t.addEventListener('click', () => open(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(i); }
      });
    });

    const stageBox = () => stage.getBoundingClientRect();

    function layout() {
      const r = stageBox();
      fit = Math.min(r.width / natW, r.height / natH, 1);
      fitW = natW * fit;
      fitH = natH * fit;
      img.style.width = `${fitW}px`;
      img.style.height = `${fitH}px`;
      maxS = Math.max(3, 2 / fit);
    }

    function constrain() {
      const r = stageBox();
      const ox = Math.max(0, (fitW * s - r.width) / 2);
      const oy = Math.max(0, (fitH * s - r.height) / 2);
      tx = clamp(tx, -ox, ox);
      ty = clamp(ty, -oy, oy);
    }

    function render() {
      img.style.transform = `translate(${tx}px, ${ty}px) scale(${s})`;
      const zoomed = s > 1.01;
      dlg.classList.toggle('is-zoomed', zoomed);
      pct.textContent = `${Math.round(s * fit * 100)}%`;
      zoomOutBtn.disabled = !zoomed;
      zoomInBtn.disabled = s >= maxS - 0.01;
    }

    function zoomAt(next: number, cx: number, cy: number) {
      const r = stageBox();
      const ns = clamp(next, 1, maxS);
      const px = cx - (r.left + r.width / 2);
      const py = cy - (r.top + r.height / 2);
      tx = px - (px - tx) * (ns / s);
      ty = py - (py - ty) * (ns / s);
      s = ns;
      constrain();
      render();
    }

    const zoomCenter = (next: number) => {
      const r = stageBox();
      zoomAt(next, r.left + r.width / 2, r.top + r.height / 2);
    };
    const resetZoom = () => { s = 1; tx = 0; ty = 0; render(); };
    const actualSize = () => Math.min(maxS, Math.max(1.5, 1 / fit));
    const toggleZoom = (cx: number, cy: number) => (s > 1.01 ? resetZoom() : zoomAt(actualSize(), cx, cy));

    function show(i: number, dir = 0) {
      idx = (i + thumbs.length) % thumbs.length;
      const t = thumbs[idx]!;
      natW = Number(t.getAttribute('width')) || t.naturalWidth || 1600;
      natH = Number(t.getAttribute('height')) || t.naturalHeight || 900;
      s = 1; tx = 0; ty = 0;
      img.src = t.currentSrc || t.src;
      img.alt = t.alt;
      caption.textContent = t.alt;
      counter.textContent = single ? '' : `${idx + 1} / ${thumbs.length}`;
      layout();
      render();

      const full = largestSrc(t);
      if (full !== img.src) {
        dlg.classList.add('is-loading');
        const pre = new Image();
        pre.src = full;
        pre.decode().then(() => { if (thumbs[idx] === t) img.src = full; }).catch(() => {}).finally(() => {
          if (thumbs[idx] === t) dlg.classList.remove('is-loading');
        });
      }
      for (const n of [idx + 1, idx - 1]) new Image().src = largestSrc(thumbs[(n + thumbs.length) % thumbs.length]!);

      if (dir && !reduced()) {
        frame.animate([{ opacity: 0, transform: `translateX(${dir * 48}px)` }, { opacity: 1, transform: 'none' }], { duration: 260, easing: EASE });
      }
    }

    const go = (dir: number) => { if (!single) show(idx + dir, dir); };

    function flipFrom(rect: DOMRect) {
      const to = img.getBoundingClientRect();
      const dx = rect.left + rect.width / 2 - (to.left + to.width / 2);
      const dy = rect.top + rect.height / 2 - (to.top + to.height / 2);
      return `translate(${dx}px, ${dy}px) scale(${rect.width / to.width})`;
    }

    function open(i: number) {
      if (dlg.open) return;
      document.documentElement.classList.add('lb-lock');
      dlg.showModal();
      show(i);
      if (!reduced()) {
        const from = flipFrom(thumbs[idx]!.getBoundingClientRect());
        frame.animate([{ transform: from }, { transform: 'none' }], { duration: 380, easing: EASE });
        bg.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: 'ease-out' });
        for (const el of dlg.querySelectorAll('.lb-chrome')) el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, delay: 120, fill: 'backwards' });
      }
      if (!hintShown) {
        hintShown = true;
        dlg.classList.add('show-hint');
        hintTimer = window.setTimeout(() => dlg.classList.remove('show-hint'), 4500);
      }
    }

    async function close() {
      if (closing || !dlg.open) return;
      closing = true;
      const t = thumbs[idx]!;
      const tr = t.getBoundingClientRect();
      if (tr.bottom < 0 || tr.top > innerHeight) t.scrollIntoView({ block: 'center', behavior: 'instant' });
      if (!reduced()) {
        dlg.classList.add('is-gesture');
        resetZoom();
        const to = flipFrom(t.getBoundingClientRect());
        const anims = [
          frame.animate([{ transform: frame.style.transform || 'none', opacity: 1 }, { transform: to, opacity: 1 }], { duration: 300, easing: EASE, fill: 'forwards' }),
          bg.animate([{ opacity: getComputedStyle(bg).opacity }, { opacity: 0 }], { duration: 260, easing: 'ease-in', fill: 'forwards' }),
          ...[...dlg.querySelectorAll('.lb-chrome')].map((el) => el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 150, fill: 'forwards' })),
        ];
        await Promise.all(anims.map((a) => a.finished.catch(() => {})));
        anims.forEach((a) => a.cancel());
      }
      dlg.close();
    }

    dlg.addEventListener('close', () => {
      closing = false;
      clearTimeout(hintTimer);
      dlg.classList.remove('show-hint', 'chrome-hidden', 'is-zoomed', 'is-loading', 'is-gesture');
      resetZoom();
      frame.style.transform = '';
      bg.style.opacity = '';
      document.documentElement.classList.remove('lb-lock');
      thumbs[idx]!.focus({ preventScroll: true });
    });
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });

    q('[data-close]').addEventListener('click', () => close());
    bg.addEventListener('click', () => close());
    q('[data-prev]').addEventListener('click', () => go(-1));
    q('[data-next]').addEventListener('click', () => go(1));
    zoomInBtn.addEventListener('click', () => zoomCenter(s * 1.6));
    zoomOutBtn.addEventListener('click', () => zoomCenter(s / 1.6));
    pct.addEventListener('click', () => (s > 1.01 ? resetZoom() : zoomCenter(actualSize())));

    dlg.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const k = e.key;
      if (k === 'ArrowLeft') go(-1);
      else if (k === 'ArrowRight') go(1);
      else if (k === '+' || k === '=') zoomCenter(s * 1.6);
      else if (k === '-' || k === '_') zoomCenter(s / 1.6);
      else if (k === '0') resetZoom();
      else return;
      e.preventDefault();
      dlg.classList.remove('show-hint');
    });

    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      dlg.classList.add('is-gesture');
      clearTimeout(wheelTimer);
      wheelTimer = window.setTimeout(() => dlg.classList.remove('is-gesture'), 160);
      const speed = e.ctrlKey ? 0.01 : e.deltaMode === 1 ? 0.05 : 0.0018;
      zoomAt(s * Math.exp(-e.deltaY * speed), e.clientX, e.clientY);
      dlg.classList.remove('show-hint');
    }, { passive: false });

    const pts = new Map<number, { x: number; y: number }>();
    let base = { x: 0, y: 0, dist: 1, s: 1, tx: 0, ty: 0 };
    let downTarget: EventTarget | null = null;
    let moved = false, multi = false, swipeX = 0, swipeY = 0, lastTap = 0, tapTimer = 0, downAt = 0;

    const center = () => {
      const p = [...pts.values()];
      return { x: p.reduce((a, b) => a + b.x, 0) / p.length, y: p.reduce((a, b) => a + b.y, 0) / p.length };
    };
    const spread = () => {
      const [a, b] = [...pts.values()];
      return a && b ? Math.hypot(a.x - b.x, a.y - b.y) : 1;
    };
    const rebase = () => { const c = center(); base = { x: c.x, y: c.y, dist: spread(), s, tx, ty }; };

    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      if (!pts.size) { moved = false; multi = false; swipeX = 0; swipeY = 0; downAt = performance.now(); downTarget = e.target; }
      stage.setPointerCapture(e.pointerId);
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pts.size > 1) multi = true;
      rebase();
      dlg.classList.add('is-gesture');
    });

    stage.addEventListener('pointermove', (e) => {
      if (!pts.has(e.pointerId)) return;
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      const c = center();
      const dx = c.x - base.x, dy = c.y - base.y;
      if (!moved && Math.hypot(dx, dy) > 6) moved = true;
      if (!moved && pts.size < 2) return;
      dlg.classList.remove('show-hint');

      if (pts.size >= 2) {
        const r = stageBox();
        const ns = clamp(base.s * (spread() / base.dist), 1, maxS);
        const p0x = base.x - (r.left + r.width / 2), p0y = base.y - (r.top + r.height / 2);
        const p1x = c.x - (r.left + r.width / 2), p1y = c.y - (r.top + r.height / 2);
        tx = p1x - (p0x - base.tx) * (ns / base.s);
        ty = p1y - (p0y - base.ty) * (ns / base.s);
        s = ns;
        constrain();
        render();
      } else if (s > 1.01) {
        tx = base.tx + dx;
        ty = base.ty + dy;
        constrain();
        render();
      } else if (!multi) {
        if (!swipeX && !swipeY) (Math.abs(dx) > Math.abs(dy) ? (swipeX = 1) : (swipeY = 1));
        if (swipeX && !single) {
          frame.style.transform = `translateX(${dx}px)`;
        } else if (swipeY && dy > 0) {
          frame.style.transform = `translateY(${dy}px) scale(${1 - Math.min(dy, 400) / 1600})`;
          bg.style.opacity = String(1 - Math.min(dy, 400) / 500);
        }
      }
    });

    function snapBack() {
      const from = frame.style.transform;
      frame.style.transform = '';
      bg.style.opacity = '';
      if (from && !reduced()) frame.animate([{ transform: from }, { transform: 'none' }], { duration: 220, easing: EASE });
    }

    function endGesture(e: PointerEvent) {
      if (!pts.delete(e.pointerId)) return;
      if (pts.size) { rebase(); return; }
      dlg.classList.remove('is-gesture');
      const dx = e.clientX - base.x, dy = e.clientY - base.y;
      const fast = performance.now() - downAt < 300;

      if (moved) {
        if (s > 1.01 || multi) { snapBack(); return; }
        if (swipeX && !single && (Math.abs(dx) > 80 || (fast && Math.abs(dx) > 30))) {
          frame.style.transform = '';
          go(dx < 0 ? 1 : -1);
        } else if (swipeY && (dy > 120 || (fast && dy > 50))) {
          close();
        } else snapBack();
        return;
      }
      if (e.type === 'pointercancel') return;
      tap(e);
    }
    stage.addEventListener('pointerup', endGesture);
    stage.addEventListener('pointercancel', endGesture);

    function tap(e: PointerEvent) {
      const onImage = downTarget === img;
      if (e.pointerType === 'mouse') {
        if (onImage) toggleZoom(e.clientX, e.clientY);
        else close();
        return;
      }
      const now = performance.now();
      if (now - lastTap < 300) {
        clearTimeout(tapTimer);
        lastTap = 0;
        toggleZoom(e.clientX, e.clientY);
        return;
      }
      lastTap = now;
      tapTimer = window.setTimeout(() => {
        if (!onImage && s <= 1.01) close();
        else dlg.classList.toggle('chrome-hidden');
      }, 300);
    }

    addEventListener('resize', () => {
      if (!dlg.open) return;
      layout();
      resetZoom();
    });
  }

  const dlg = document.querySelector<HTMLDialogElement>('dialog[data-lb]');
  const root = document.querySelector('[data-lightbox]');
  if (dlg && root) init(dlg, root);
</script>

<style is:global>
  html.lb-lock { overflow: hidden; }

  .lb-thumb { position: relative; display: block; }
  .lb-thumb > img { cursor: zoom-in; transition: filter 0.2s; }
  .lb-thumb:hover > img { filter: brightness(0.97); }
  .lb-thumb > img:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .lb-badge {
    position: absolute; top: 0.75rem; right: 0.75rem;
    display: inline-flex; align-items: center; gap: 0.375rem;
    padding: 0.375rem 0.625rem; border-radius: 9999px;
    background: rgb(0 0 0 / 0.62); color: #fff; font-size: 0.75rem; font-weight: 500; line-height: 1;
    backdrop-filter: blur(6px); pointer-events: none;
    opacity: 0; transform: translateY(-4px); transition: opacity 0.2s, transform 0.2s var(--ease);
  }
  .lb-thumb:hover .lb-badge, .lb-thumb:focus-within .lb-badge { opacity: 1; transform: none; }
  @media (hover: none) {
    .lb-badge { opacity: 1; transform: none; padding: 0.375rem; }
    .lb-badge > span { display: none; }
  }

  .lb {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0; background: transparent; color: #fff; overflow: hidden; outline: none;
  }
  .lb::backdrop { background: transparent; }
  .lb-bg { position: absolute; inset: 0; background: rgb(9 9 11 / 0.94); backdrop-filter: blur(8px); }

  .lb-stage {
    position: absolute; inset: 4.5rem 5.5rem 5.5rem;
    display: flex; align-items: center; justify-content: center;
    touch-action: none; user-select: none; -webkit-user-select: none;
  }
  .lb-frame img {
    display: block; max-width: none; border-radius: 0.5rem; background: rgb(255 255 255 / 0.04);
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.5);
    cursor: zoom-in; transform-origin: center; transition: transform 0.28s var(--ease);
    -webkit-user-drag: none;
  }
  .lb.is-zoomed .lb-frame img { cursor: grab; border-radius: 0; }
  .lb.is-gesture .lb-frame img { transition: none; }
  .lb.is-zoomed.is-gesture .lb-frame img { cursor: grabbing; }

  .lb-chrome { transition: opacity 0.2s, background-color 0.2s; }
  .lb.is-zoomed .lb-top, .lb.is-zoomed .lb-bottom { background: rgb(9 9 11 / 0.72); backdrop-filter: blur(10px); }
  .lb.chrome-hidden .lb-chrome { opacity: 0; pointer-events: none; }
  .lb-top {
    position: absolute; inset: 0 0 auto; display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: 0.75rem 1rem 0.75rem 1.25rem;
    background: linear-gradient(rgb(0 0 0 / 0.55), transparent);
  }
  .lb-counter { display: flex; align-items: center; gap: 0.625rem; font-size: 0.875rem; color: rgb(255 255 255 / 0.75); }
  .lb-spin {
    width: 0.875rem; height: 0.875rem; border-radius: 9999px; border: 2px solid rgb(255 255 255 / 0.25);
    border-top-color: #fff; opacity: 0; transition: opacity 0.2s; animation: lb-spin 0.7s linear infinite;
  }
  .lb.is-loading .lb-spin { opacity: 1; transition-delay: 0.15s; }
  @keyframes lb-spin { to { transform: rotate(360deg); } }
  .lb-tools { display: flex; align-items: center; gap: 0.25rem; }
  .lb-sep { width: 1px; height: 1.25rem; margin: 0 0.375rem; background: rgb(255 255 255 / 0.2); }

  .lb-btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 2.75rem; height: 2.75rem; padding: 0 0.5rem; border-radius: 9999px;
    color: #fff; background: transparent; cursor: pointer; transition: background-color 0.15s, opacity 0.15s;
  }
  .lb-btn:hover { background: rgb(255 255 255 / 0.12); }
  .lb-btn:active { background: rgb(255 255 255 / 0.2); }
  .lb-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .lb-btn:disabled { opacity: 0.35; cursor: default; background: transparent; }
  .lb-pct { min-width: 4rem; font-size: 0.8125rem; font-weight: 500; }

  .lb-nav { position: absolute; top: 50%; translate: 0 -50%; width: 3rem; height: 3rem; background: rgb(0 0 0 / 0.5); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14); backdrop-filter: blur(6px); }
  .lb-nav:hover { background: rgb(0 0 0 / 0.7); }
  .lb-prev { left: 1rem; }
  .lb-next { right: 1rem; }
  .lb.is-single .lb-nav { display: none; }

  .lb-bottom {
    position: absolute; inset: auto 0 0; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    padding: 1.25rem 1rem 1rem; text-align: center; pointer-events: none;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.55));
  }
  .lb-caption { max-width: 48rem; font-size: 0.875rem; color: rgb(255 255 255 / 0.85); }
  .lb-hint {
    padding: 0.375rem 0.875rem; border-radius: 9999px; background: rgb(255 255 255 / 0.1);
    font-size: 0.75rem; color: rgb(255 255 255 / 0.8);
    opacity: 0; translate: 0 6px; transition: opacity 0.3s, translate 0.3s var(--ease);
  }
  .lb.show-hint .lb-hint { opacity: 1; translate: 0 0; }
  .lb-hint-touch { display: none; }
  @media (pointer: coarse) {
    .lb-hint-mouse { display: none; }
    .lb-hint-touch { display: inline; }
  }

