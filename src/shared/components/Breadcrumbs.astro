---
/** Breadcrumb hiển thị. JSON-LD BreadcrumbList do trang truyền vào Seo. */
import { resolveLocale, useTranslations } from '@i18n/utils';

export interface Crumb { name: string; href: string }
interface Props { items: Crumb[] }

const { items } = Astro.props;
const t = useTranslations(resolveLocale(Astro.currentLocale));
---

<nav class="breadcrumbs p-0 text-sm text-base-content/60" aria-label={t('common.breadcrumb')}>
  <ul>
    {
      items.map((item, i) =>
        i === items.length - 1 ? (
          <li aria-current="page" class="text-base-content">{item.name}</li>
        ) : (
          <li><a href={item.href} class="hover:text-primary">{item.name}</a></li>
        ),
      )
    }
  </ul>
</nav>
