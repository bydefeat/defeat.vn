---
/**
 * Header cố định: logo, menu chính, đổi ngôn ngữ, CTA báo giá.
 * Menu mobile dùng <details> — không cần JavaScript.
 */
import { Image } from 'astro:assets';
import brand from '@/assets/brand/defeat_brand.png';
import { MAIN_NAV } from '@config/site';
import { LOCALES, LOCALE_META, type Locale } from '@i18n/config';
import { localizePath, useTranslations } from '@i18n/utils';

interface Props {
  locale: Locale;
  path: string;
  availableLocales?: readonly Locale[];
}

const { locale, path, availableLocales = LOCALES } = Astro.props;
const t = useTranslations(locale);
const isActive = (navPath: string) => path === navPath || path.startsWith(navPath + '/');
const langHref = (l: Locale) => localizePath(availableLocales.includes(l) ? path : '/', l);
---

<header class="sticky top-0 z-50 border-b border-base-300 bg-base-100/90 backdrop-blur supports-[backdrop-filter]:bg-base-100/75">
  <nav class="container-x flex h-16 items-center gap-6" aria-label="Main">
    <a href={localizePath('/', locale)} class="flex shrink-0 items-center" aria-label={`DEFEAT — ${t('nav.home')}`}>
      <Image src={brand} alt="DEFEAT" height={28} class="h-7 w-auto" loading="eager" fetchpriority="high" />
    </a>

    <ul class="hidden flex-1 items-center gap-1 lg:flex">
      {
        MAIN_NAV.map((item) => (
          <li>
            <a
              href={localizePath(item.path, locale)}
              class:list={[
                'rounded-field px-3 py-2 text-sm font-medium transition-colors hover:text-primary',
                isActive(item.path) ? 'text-primary' : 'text-base-content/80',
              ]}
              aria-current={isActive(item.path) ? 'page' : undefined}
            >
              {t(`nav.${item.key}`)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto hidden items-center gap-3 lg:flex">
      <div class="flex items-center gap-1 text-xs font-semibold" aria-label={t('common.language')}>
        {
          LOCALES.map((l) => (
            <a
              href={langHref(l)}
              hreflang={LOCALE_META[l].hreflang}
              lang={LOCALE_META[l].hreflang}
              title={LOCALE_META[l].label}
              class:list={['rounded px-2 py-1 uppercase', l === locale ? 'bg-base-200 text-base-content' : 'text-base-content/60 hover:text-primary']}
              aria-current={l === locale ? 'true' : undefined}
            >
              {l}
            </a>
          ))
        }
      </div>
      <a href={localizePath('/contact', locale)} class="btn btn-primary btn-sm">{t('cta.quote')}</a>
    </div>

    <details class="group relative ml-auto lg:hidden">
      <summary class="btn btn-ghost btn-sm btn-square list-none" aria-label={t('nav.menu')}>
        <svg class="size-6 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg class="hidden size-6 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </summary>
      <div class="fixed inset-x-0 top-16 border-b border-base-300 bg-base-100 shadow-lg">
        <ul class="container-x flex flex-col py-4">
          {
            MAIN_NAV.map((item) => (
              <li>
                <a href={localizePath(item.path, locale)} class="block border-b border-base-200 py-3 font-medium">
                  {t(`nav.${item.key}`)}
                </a>
              </li>
            ))
          }
          <li class="flex items-center justify-between gap-4 pt-4">
            <div class="flex gap-2">
              {LOCALES.map((l) => (
                <a href={langHref(l)} hreflang={LOCALE_META[l].hreflang} class:list={['btn btn-sm', l === locale ? 'btn-neutral' : 'btn-ghost']}>
                  {l.toUpperCase()}
                </a>
              ))}
            </div>
            <a href={localizePath('/contact', locale)} class="btn btn-primary btn-sm">{t('cta.quote')}</a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>
