---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  id?: string;
  /** Mức heading — mỗi trang chỉ có một h1. */
  as?: 'h1' | 'h2';
}
const { eyebrow, title, description, align = 'left', id, as: Tag = 'h2' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</Tag>
  {description && <p class="mt-4 text-lg text-base-content/70 text-pretty">{description}</p>}
  <slot />
</div>
