---
/** Tiêu đề section: eyebrow mono (decode) + tiêu đề + mô tả, có reveal. */
interface Props {
  eyebrow?: string;
  /** Số thứ tự section, vd. "01". */
  index?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  id?: string;
  as?: 'h1' | 'h2';
  tone?: 'light' | 'dark';
}
const { eyebrow, index, title, description, align = 'left', id, as: Tag = 'h2', tone = 'light' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  {
    eyebrow && (
      <p class="eyebrow">
        {index && <span class="text-base-content/40 [.on-dark_&]:text-neutral-content/40">{index} /</span>}
        <span data-scramble>{eyebrow}</span>
      </p>
    )
  }
  <Tag id={id} class="display mt-4 text-3xl leading-[1.08] sm:text-5xl">{title}</Tag>
  {description && <p class:list={['mt-5 text-lg text-pretty', tone === 'dark' ? 'text-neutral-content/70' : 'text-base-content/65']}>{description}</p>}
  <slot />
</div>
