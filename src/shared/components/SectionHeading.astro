---
/** Tiêu đề section: eyebrow + tiêu đề + mô tả, hiện bằng dither dissolve. */
interface Props {
  eyebrow?: string;
  /** Số thứ tự section, vd. "01". */
  index?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  id?: string;
  as?: 'h1' | 'h2';
  tone?: 'light' | 'dark';
}
const { eyebrow, index, title, description, align = 'left', id, as: Tag = 'h2', tone = 'light' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  {
    eyebrow && (
      <p class="eyebrow">
        {index && <span class:list={['num', tone === 'dark' ? 'text-neutral-content/40' : 'text-base-content/35']}>{index}</span>}
        {eyebrow}
      </p>
    )
  }
  <Tag id={id} class="t-h2 mt-4">{title}</Tag>
  {description && <p class:list={['t-lead mt-5', tone === 'dark' ? 'text-neutral-content/70' : 'text-base-content/65']}>{description}</p>}
  <slot />
</div>
