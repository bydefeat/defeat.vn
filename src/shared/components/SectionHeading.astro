---
/** Tiêu đề section: nhãn nhỏ (tuỳ chọn) + tiêu đề + gạch đỏ + mô tả. */
interface Props {
  eyebrow?: string;
  /** Giữ để tương thích, không hiển thị. */
  index?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  id?: string;
  as?: 'h1' | 'h2';
  tone?: 'light' | 'dark';
}
const { eyebrow, title, description, align = 'left', id, as: Tag = 'h2', tone = 'light' } = Astro.props;
const center = align === 'center';
---

<div class:list={['max-w-3xl', center && 'mx-auto text-center']} data-reveal>
  {eyebrow && <p class="t-label text-primary">{eyebrow}</p>}
  <Tag id={id} class:list={['t-h2', eyebrow && 'mt-2']}>{title}</Tag>
  <span class:list={['accent-bar', center && 'mx-auto']} aria-hidden="true"></span>
  {description && <p class:list={['t-lead mt-5', tone === 'dark' ? 'text-neutral-content/75' : 'text-muted']}>{description}</p>}
  <slot />
</div>
